<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Empty, themed host for instrumented dialog tests. -->
        <activity
            android:name="android.app.Activity"
            android:exported="false"
            android:theme="@style/Theme.Overdrive.M3" />
        <receiver
            android:name="com.overdrive.app.voice.VoiceOverlayDemoReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.overdrive.app.debug.VOICE_OVERLAY_DEMO" />
            </intent-filter>
        </receiver>
        <receiver
            android:name="com.overdrive.app.voice.VoiceEngineHarnessReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="com.overdrive.app.debug.VOICE_ENGINE_HARNESS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
