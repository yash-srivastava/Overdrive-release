<?xml version="1.0" encoding="utf-8"?>
<!--
  Recordings page — landscape. Two-pane: library list (left) + inline player
  pane (right). Filter strip identical to portrait so users get the same
  affordances on the BYD landscape head-unit. The filter rows pack onto
  multiple rows on landscape:
    Row A: title row + Settings (always full-width).
    Row B: segmented Dashcam | Surveillance + date jump card.
    Row C: single compact quick-filter row — TYPE (Dashcam) or WHAT +
           SEVERITY (Surveillance) chips plus PLACE chips in one horizontal
           scroller, Reset pinned trailing. Replaces the old Row C + Row D
           pair so the two-pane body gets the reclaimed height.

  IDs preserved (consumed by RecordingsFragment.kt):
    segmentedSource, segmentDashcam, segmentReplays, segmentSurveillance,
    btnRecordingsSettings, libraryContainer, previewContainer, previewPlaceholder,
    btnPrevDay, btnNextDay, cardDateJump, tvSelectedDate, tvDayClipCount,
    chipActorAny, chipActorPerson, chipActorVehicle, chipActorBike, chipActorAnimal,
    chipSevAny, chipSevAlert, chipSevCritical, btnFilterReset,
    rowTypeFilter, rowWhatFilter, scrollSeverityChips, rowPlaceFilter,
    chipGroupType, chipTypeNormal, chipTypeProximity,
    chipGroupWhat, chipGroupSeverity, chipGroupPlace.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:orientation="vertical">

    <!-- ============ Header: counts + page actions ============ -->
    <LinearLayout
        android:id="@+id/heroHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding_horizontal"
        android:paddingTop="@dimen/page_padding_top"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:baselineAligned="false">

            <!--
              The app bar already names this screen, so the header carries
              the counts instead. Populated by refreshCounts(); the pending
              string holds the line's height until the first scan lands.
            -->
            <TextView
                android:id="@+id/tvRecordingsSummary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:singleLine="true"
                android:ellipsize="end"
                android:text="@string/recordings_summary_pending"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                android:textColor="?attr/colorOnSurfaceVariant"
                tools:text="12 today · 320 total · 42 GB" />

            <!-- Free-text place search. Lives in the title row so it sits
                 next to the date card on the row below; debounced 300ms in
                 RecordingsFragment.setupPlaceSearch and pushed through
                 applyAll(placeContains=…). Landscape-only — portrait users
                 still rely on the chip row for place narrowing. -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardPlaceSearch"
                android:layout_width="220dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardCornerRadius="@dimen/card_radius_standard"
                app:cardElevation="0dp"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingStart="12dp"
                    android:paddingEnd="4dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_events"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <EditText
                        android:id="@+id/etPlaceSearch"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:background="@null"
                        android:hint="@string/recording_lib_place_search_hint"
                        android:imeOptions="actionSearch"
                        android:importantForAutofill="no"
                        android:inputType="text"
                        android:maxLines="1"
                        android:singleLine="true"
                        android:textColor="?attr/colorOnSurface"
                        android:textColorHint="?attr/colorOnSurfaceVariant"
                        android:textSize="14sp" />

                    <ImageButton
                        android:id="@+id/btnClearPlaceSearch"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/recording_library_clear_search"
                        android:padding="14dp"
                        android:src="@drawable/ic_clear"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectRecordings"
                style="@style/Widget.Overdrive.M3.Button.Header"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/recording_library_select"
                android:text="@string/recording_library_select"
                app:icon="@drawable/ic_check_circle"
                app:iconGravity="textStart" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordingsSettings"
                style="@style/Widget.Overdrive.M3.Button.Header"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/recordings_action_settings"
                android:text="@string/recordings_action_settings"
                app:icon="@drawable/ic_settings"
                app:iconGravity="textStart" />
        </LinearLayout>
    </LinearLayout>

    <!-- ============ Top filter strip ============ -->
    <LinearLayout
        android:id="@+id/filterStrip"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/page_padding_horizontal"
        android:paddingBottom="6dp">

        <!-- Row B: segmented control + date jump -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:baselineAligned="false">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/segmentedSource"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:checkedButton="@id/segmentAll"
                app:singleSelection="true"
                app:selectionRequired="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segmentAll"
                    style="@style/Widget.Overdrive.M3.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/recordings_segment_all"
                    android:textAllCaps="false" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segmentDashcam"
                    style="@style/Widget.Overdrive.M3.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/recordings_segment_dashcam"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_directions_car"
                    app:iconSize="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segmentReplays"
                    style="@style/Widget.Overdrive.M3.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/recordings_segment_replays"
                    android:textAllCaps="false"
                    android:maxLines="1"
                    android:ellipsize="end"
                    app:icon="@drawable/ic_instant_replay"
                    app:iconSize="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segmentSurveillance"
                    style="@style/Widget.Overdrive.M3.Button.Outlined"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/recordings_segment_surveillance"
                    android:textAllCaps="false"
                    app:icon="@drawable/ic_sentry"
                    app:iconSize="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="6dp" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPrevDay"
                style="@style/Widget.Overdrive.M3.HeaderIconButton.Compact"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/cd_previous_day"
                app:icon="@drawable/ic_chevron_left"
                app:iconSize="22dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardDateJump"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="6dp"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="40dp"
                app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                app:cardElevation="0dp"
                app:cardCornerRadius="@dimen/card_radius_accent"
                app:rippleColor="?attr/colorPrimary"
                app:strokeColor="?attr/colorOutlineVariant"
                app:strokeWidth="1dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="14dp"
                    android:paddingVertical="9dp">

                    <ImageView
                        android:layout_width="18dp"
                        android:layout_height="18dp"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_events"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <TextView
                        android:id="@+id/tvSelectedDate"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="10dp"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="14sp"
                        android:fontFamily="sans-serif-medium"
                        android:singleLine="true"
                        android:ellipsize="end"
                        tools:text="Today" />

                    <TextView
                        android:id="@+id/tvDayClipCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:paddingHorizontal="9dp"
                        android:paddingVertical="2dp"
                        android:background="@drawable/recording_lib_count_pill"
                        android:textColor="?attr/colorOnSurface"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-medium"
                        android:visibility="gone"
                        tools:text="12 clips"
                        tools:visibility="visible" />

                    <ImageButton
                        android:id="@+id/btnClearDate"
                        android:layout_width="48dp"
                        android:layout_height="48dp"
                        android:layout_marginStart="6dp"
                        android:background="?attr/selectableItemBackgroundBorderless"
                        android:contentDescription="@string/cd_clear_date_filter"
                        android:padding="14dp"
                        android:src="@drawable/ic_clear"
                        android:visibility="gone"
                        app:tint="?attr/colorOnSurfaceVariant"
                        tools:visibility="visible" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNextDay"
                style="@style/Widget.Overdrive.M3.HeaderIconButton.Compact"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="@string/cd_next_day"
                app:icon="@drawable/ic_chevron_right"
                app:iconSize="22dp"
                app:iconTint="?attr/colorOnSurfaceVariant"
                app:iconGravity="textStart"
                app:iconPadding="0dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenRecordingFilters"
                style="@style/Widget.Overdrive.M3.HeaderIconButton.Compact"
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:contentDescription="@string/recording_library_open_filters"
                app:icon="@drawable/ic_filter_list"
                app:iconSize="22dp"
                app:iconTint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <!-- Row C: single compact quick-filter row. TYPE (Dashcam) or
             WHAT + SEVERITY (Surveillance) chips plus PLACE chips share one
             horizontal scroller so the two-pane body below (library grid +
             inline player) gets the reclaimed height of the old Row D.
             Section labels are dropped here for compactness — actor and
             severity chips carry icons; the fully labelled sections live in
             the filter bottom sheet. Per-segment visibility is driven by
             RecordingsFragment.applyChipRowVisibility (rowTypeFilter ↔
             Dashcam; rowWhatFilter + scrollSeverityChips ↔ Surveillance);
             rowPlaceFilter is toggled by renderPlaceChips when geocoded
             clips exist. Reset stays pinned outside the scroller. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp"
            android:baselineAligned="false">

            <HorizontalScrollView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:scrollbars="none"
                android:overScrollMode="never">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <!-- TYPE chips (Dashcam segment only) -->
                    <LinearLayout
                        android:id="@+id/rowTypeFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone"
                        tools:visibility="visible">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupType"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:singleLine="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipTypeNormal"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_type_normal" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipTypeProximity"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_type_proximity" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- WHAT chips (Surveillance segment only) -->
                    <LinearLayout
                        android:id="@+id/rowWhatFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupWhat"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:singleLine="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipActorAny"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_any"
                                android:checked="true" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipActorPerson"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_person"
                                app:chipIcon="@drawable/ic_person"
                                app:chipIconSize="16dp"
                                app:chipIconTint="?attr/colorOnSurfaceVariant"
                                app:chipIconVisible="true" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipActorVehicle"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_vehicle"
                                app:chipIcon="@drawable/ic_directions_car"
                                app:chipIconSize="16dp"
                                app:chipIconTint="?attr/colorOnSurfaceVariant"
                                app:chipIconVisible="true" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipActorBike"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_bike"
                                app:chipIcon="@drawable/ic_pedal_bike"
                                app:chipIconSize="16dp"
                                app:chipIconTint="?attr/colorOnSurfaceVariant"
                                app:chipIconVisible="true" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipActorAnimal"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_animal"
                                app:chipIcon="@drawable/ic_pets"
                                app:chipIconSize="16dp"
                                app:chipIconTint="?attr/colorOnSurfaceVariant"
                                app:chipIconVisible="true" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- SEVERITY chips (Surveillance segment only) -->
                    <LinearLayout
                        android:id="@+id/scrollSeverityChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupSeverity"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:singleLine="true">

                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSevAny"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_any"
                                android:checked="true" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSevAlert"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_alert"
                                app:chipIcon="@drawable/ic_warning"
                                app:chipIconSize="16dp"
                                app:chipIconTint="?attr/colorOnSurfaceVariant"
                                app:chipIconVisible="true" />
                            <com.google.android.material.chip.Chip
                                android:id="@+id/chipSevCritical"
                                style="@style/Widget.Overdrive.M3.Chip.Filter"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/recording_lib_chip_critical"
                                app:chipIcon="@drawable/ic_error"
                                app:chipIconSize="16dp"
                                app:chipIconTint="?attr/colorOnSurfaceVariant"
                                app:chipIconVisible="true" />
                        </com.google.android.material.chip.ChipGroup>
                    </LinearLayout>

                    <!-- PLACE chips — populated from Kotlin
                         (renderPlaceChips); hidden until geocoding has
                         tagged at least one clip. -->
                    <LinearLayout
                        android:id="@+id/rowPlaceFilter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:visibility="gone">

                        <com.google.android.material.chip.ChipGroup
                            android:id="@+id/chipGroupPlace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            app:chipSpacingHorizontal="6dp"
                            app:singleLine="true" />
                    </LinearLayout>
                </LinearLayout>
            </HorizontalScrollView>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterReset"
                style="@style/Widget.Overdrive.M3.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="6dp"
                android:text="@string/recording_lib_filter_reset"
                android:textAllCaps="false"
                android:textSize="12sp"
                android:visibility="gone"
                android:minHeight="48dp"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- STORAGE chips row — narrow to one physical volume (Internal / SD /
             USB). Mirrors the portrait layout's rowStorageFilter so the shared
             RecordingsFragment.setupChipFilters findViewById calls resolve on
             both orientations. -->
        <HorizontalScrollView
            android:id="@+id/rowStorageFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:scrollbars="none"
            android:overScrollMode="never"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="8dp"
                    android:text="@string/recording_lib_filter_section_storage"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="11sp"
                    android:fontFamily="sans-serif-medium"
                    android:letterSpacing="0.06"
                    android:textAllCaps="true" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupStorage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStorageAny"
                        style="@style/Widget.Overdrive.M3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recording_lib_chip_any"
                        android:checked="true" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStorageInternal"
                        style="@style/Widget.Overdrive.M3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recording_lib_storage_filter_internal" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStorageSd"
                        style="@style/Widget.Overdrive.M3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recording_lib_storage_filter_sd" />
                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStorageUsb"
                        style="@style/Widget.Overdrive.M3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recording_lib_storage_filter_usb" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </HorizontalScrollView>
    </LinearLayout>

    <!-- ============ Two-pane body ============ -->
    <LinearLayout
        android:id="@+id/twoPaneBody"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/page_padding_horizontal"
        android:paddingBottom="@dimen/page_padding_bottom"
        android:baselineAligned="false">

        <!-- LEFT: library list -->
        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/libraryContainer"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="11" />

        <View
            android:id="@+id/paneSpacer"
            android:layout_width="@dimen/card_gap_vertical"
            android:layout_height="match_parent" />

        <!-- RIGHT: selected recording with persistent event context. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/previewCard"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="9"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/card_radius_hero"
            app:cardElevation="0dp">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:id="@+id/previewContent"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="8dp"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <LinearLayout
                        android:id="@+id/previewContentHeader"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:minHeight="44dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/tvPreviewTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:ellipsize="end"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold"
                                tools:text="Person detected" />

                            <TextView
                                android:id="@+id/tvPreviewFilename"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="2dp"
                                android:ellipsize="middle"
                                android:maxLines="1"
                                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                                android:textColor="?attr/colorOnSurfaceVariant"
                                tools:text="event_20260802_163016.mp4" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/tvPreviewSeverityBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:background="?attr/colorSurfaceContainerHighest"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp"
                            android:visibility="gone"
                            tools:text="CRITICAL"
                            tools:visibility="visible" />

                        <TextView
                            android:id="@+id/tvPreviewTypeBadge"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="6dp"
                            android:background="?attr/colorSurfaceContainerHighest"
                            android:fontFamily="sans-serif-medium"
                            android:paddingHorizontal="8dp"
                            android:paddingVertical="4dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="10sp"
                            tools:text="EVENT" />

                        <ImageButton
                            android:id="@+id/btnPreviewMore"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:layout_marginStart="4dp"
                            android:background="?attr/selectableItemBackgroundBorderless"
                            android:contentDescription="@string/cd_recording_more_actions"
                            android:padding="12dp"
                            android:src="@drawable/ic_more_vert"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </LinearLayout>

                    <FrameLayout
                        android:id="@+id/previewContainer"
                        android:layout_width="match_parent"
                        android:layout_height="0dp"
                        android:layout_marginTop="6dp"
                        android:layout_weight="1"
                        android:background="@android:color/black"
                        android:minHeight="184dp" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/previewInsightsToggle"
                        android:layout_width="match_parent"
                        android:layout_height="48dp"
                        android:layout_marginTop="8dp"
                        android:clickable="true"
                        android:focusable="true"
                        app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
                        app:cardCornerRadius="@dimen/card_radius_standard"
                        app:cardElevation="0dp"
                        app:rippleColor="?attr/colorPrimary"
                        app:strokeColor="?attr/colorOutlineVariant"
                        app:strokeWidth="1dp">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center_vertical"
                            android:orientation="horizontal"
                            android:paddingStart="14dp"
                            android:paddingEnd="12dp">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:text="@string/recording_preview_details"
                                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                                android:textColor="?attr/colorOnSurface"
                                android:textStyle="bold" />

                            <ImageView
                                android:id="@+id/ivPreviewInsightsChevron"
                                android:layout_width="24dp"
                                android:layout_height="24dp"
                                android:contentDescription="@null"
                                android:src="@drawable/ic_expand" />
                        </LinearLayout>
                    </com.google.android.material.card.MaterialCardView>

                    <include
                        android:id="@+id/previewInsights"
                        layout="@layout/recording_preview_metadata"
                        android:layout_width="match_parent"
                        android:layout_height="144dp"
                        android:layout_marginTop="6dp"
                        android:visibility="gone"
                        tools:visibility="gone" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/previewPlaceholder"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:gravity="center"
                    android:padding="32dp">

                    <FrameLayout
                        android:layout_width="80dp"
                        android:layout_height="80dp"
                        android:background="@drawable/recording_lib_empty_tile">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:layout_gravity="center"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_play_circle"
                            app:tint="?attr/colorOnSurfaceVariant" />
                    </FrameLayout>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="center"
                        android:text="@string/recordings_preview_placeholder_title"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:gravity="center"
                        android:text="@string/recordings_preview_placeholder_body"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>
            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</LinearLayout>
