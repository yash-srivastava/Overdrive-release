<?xml version="1.0" encoding="utf-8"?>
<!-- Recording details: 3-column grid (Detected, Distance, Recorded / Duration, Storage, File size). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="@dimen/od_space_4"
    android:paddingTop="@dimen/od_space_12"
    android:paddingEnd="@dimen/od_space_4"
    android:paddingBottom="@dimen/od_space_4">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Overdrive.Rec.DetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recording_preview_detected" />

            <TextView
                android:id="@+id/tvPreviewDetectedValue"
                style="@style/Widget.Overdrive.Rec.DetailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_2"
                tools:text="Car, Person" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Overdrive.Rec.DetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recording_preview_distance" />

            <TextView
                android:id="@+id/tvPreviewDistanceValue"
                style="@style/Widget.Overdrive.Rec.DetailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_2"
                tools:text="Close" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Overdrive.Rec.DetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recording_preview_recorded" />

            <TextView
                android:id="@+id/tvPreviewRecordedValue"
                style="@style/Widget.Overdrive.Rec.DetailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_2"
                tools:text="Nov 6, 2026  8:12 AM" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/od_space_12"
        android:baselineAligned="false"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Overdrive.Rec.DetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recording_preview_duration" />

            <TextView
                android:id="@+id/tvPreviewDurationValue"
                style="@style/Widget.Overdrive.Rec.DetailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_2"
                tools:text="1:00" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Overdrive.Rec.DetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recording_preview_storage" />

            <TextView
                android:id="@+id/tvPreviewStorageValue"
                style="@style/Widget.Overdrive.Rec.DetailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_2"
                tools:text="SD card" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_12"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                style="@style/Widget.Overdrive.Rec.DetailLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/recording_preview_file_size" />

            <TextView
                android:id="@+id/tvPreviewSizeValue"
                style="@style/Widget.Overdrive.Rec.DetailValue"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/od_space_2"
                tools:text="48 MB" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
