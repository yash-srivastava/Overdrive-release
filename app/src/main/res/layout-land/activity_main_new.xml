<?xml version="1.0" encoding="utf-8"?>
<!--
  Shell, landscape: docked rail + stage. The rail pushes the stage while it slides; the stage
  shows the sub-page header only on nested destinations. fitsSystemWindows keeps both between
  the head unit's system bars.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/shellRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:fitsSystemWindows="true"
    tools:context=".ui.MainActivity">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/navigationRailContainer"
            android:layout_width="@dimen/shell_rail_compact_width"
            android:layout_height="match_parent"
            android:background="?attr/colorSurfaceContainerLow"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/shell_rail_brand_height"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:id="@+id/shellBrandMark"
                    android:layout_width="@dimen/shell_rail_mark_width"
                    android:layout_height="@dimen/shell_rail_mark_height"
                    android:layout_marginStart="@dimen/shell_rail_brand_inset"
                    android:contentDescription="@string/app_name"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_brand_od" />

                <TextView
                    android:id="@+id/railBrand"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/shell_rail_wordmark_gap"
                    android:importantForAccessibility="no"
                    android:maxLines="1"
                    android:text="@string/app_name"
                    android:textAppearance="@style/TextAppearance.Overdrive.Shell.Wordmark"
                    android:visibility="gone" />
            </LinearLayout>

            <com.overdrive.app.ui.widget.SwipeExpandableRailScrollView
                android:id="@+id/navigationRailScroll"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:fadingEdgeLength="@dimen/shell_rail_fading_edge"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls"
                android:requiresFadingEdge="vertical"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/navigationRail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingTop="@dimen/od_space_2"
                    android:paddingBottom="@dimen/od_space_8">

                    <include
                        android:id="@+id/railDestDashboard"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestAssistant"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <!-- Each header hides when every row under it is unpinned
                         (MainActivity.applyNavigationRailVisibility). -->
                    <include
                        android:id="@+id/railSectionCameras"
                        layout="@layout/item_rail_section" />
                    <include
                        android:id="@+id/railDestLive"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestRecordings"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestParking"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/railSectionControls"
                        layout="@layout/item_rail_section" />
                    <include
                        android:id="@+id/railDestVehicle"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestProximity"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestSeatPositions"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestProjection"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestCharging"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/railSectionDriving"
                        layout="@layout/item_rail_section" />
                    <include
                        android:id="@+id/railDestTrips"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestRoadSense"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestMap"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestWidgets"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/railSectionAutomation"
                        layout="@layout/item_rail_section" />
                    <include
                        android:id="@+id/railDestAutomations"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestKeyMapping"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestIntegrations"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <include
                        android:id="@+id/railSectionSystem"
                        layout="@layout/item_rail_section" />
                    <include
                        android:id="@+id/railDestNotifications"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestNetwork"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestDiagnostics"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestSettings"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <include
                        android:id="@+id/railDestAbout"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                    <View
                        android:id="@+id/shellRailDivider"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/od_hairline"
                        android:layout_marginHorizontal="@dimen/shell_rail_content_inset"
                        android:layout_marginVertical="@dimen/od_space_8"
                        android:background="?attr/colorOutlineVariant" />

                    <include
                        android:id="@+id/railHelpButton"
                        layout="@layout/item_rail_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </com.overdrive.app.ui.widget.SwipeExpandableRailScrollView>

            <!-- Footer, pinned below the scroller. statusPill shows only while a tunnel is
                 starting or running; shellRemotePopover is the popover body MainActivity lifts
                 into a PopupWindow. -->
            <LinearLayout
                android:id="@+id/urlBar"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:id="@+id/statusPill"
                    android:layout_marginTop="@dimen/od_space_4"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/shell_rail_footer_row_height"
                    android:background="@drawable/shell_rail_remote_row"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/shell_rail_content_inset"
                    android:paddingEnd="@dimen/shell_rail_content_inset"
                    android:visibility="gone">

                    <FrameLayout
                        android:layout_width="@dimen/od_icon_md"
                        android:layout_height="@dimen/od_icon_md">

                        <View
                            android:id="@+id/shellRemoteHalo"
                            android:layout_width="@dimen/shell_remote_halo"
                            android:layout_height="@dimen/shell_remote_halo"
                            android:layout_gravity="center"
                            android:alpha="0.22"
                            android:background="@drawable/status_dot_offline" />

                        <View
                            android:id="@+id/urlStatusDot"
                            android:layout_width="@dimen/shell_remote_dot"
                            android:layout_height="@dimen/shell_remote_dot"
                            android:layout_gravity="center"
                            android:background="@drawable/status_dot_offline" />
                    </FrameLayout>

                    <View
                        android:id="@+id/statusIndicator"
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:visibility="gone" />

                    <LinearLayout
                        android:id="@+id/shellRemoteText"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/shell_rail_label_gap"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/dashboard_metric_tunnel"
                            android:textAlignment="viewStart"
                            android:textAppearance="@style/TextAppearance.Overdrive.Shell.RemoteTitle" />

                        <TextView
                            android:id="@+id/tvCurrentUrl"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:text="@string/dashboard_no_tunnel"
                            android:textAlignment="viewStart"
                            android:textAppearance="@style/TextAppearance.Overdrive.Shell.RemoteUrl" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/shellRemotePopover"
                    android:layout_width="@dimen/shell_popover_width"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="@dimen/shell_popover_padding"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/shellRemotePopoverTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/dashboard_metric_tunnel"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.Overdrive.Overline" />

                    <TextView
                        android:id="@+id/shellRemotePopoverUrl"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_8"
                        android:background="@drawable/shell_popover_url_bg"
                        android:paddingHorizontal="@dimen/od_space_12"
                        android:paddingVertical="@dimen/shell_popover_url_padding_v"
                        android:textAlignment="viewStart"
                        android:textAppearance="@style/TextAppearance.Overdrive.Shell.PopoverUrl"
                        android:textIsSelectable="true" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_12"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <ImageButton
                            android:id="@+id/btnCopyUrl"
                            android:layout_width="@dimen/od_touch_min"
                            android:layout_height="@dimen/od_touch_min"
                            android:background="@drawable/shell_popover_copy_bg"
                            android:contentDescription="@string/cd_copy_url"
                            android:padding="@dimen/od_space_12"
                            android:src="@drawable/ic_copy"
                            android:tooltipText="@string/cd_copy_url"
                            app:tint="?attr/colorOnSecondaryContainer" />

                        <com.google.android.material.button.MaterialButton
                            android:id="@+id/shellRemoteDetails"
                            style="@style/Widget.Material3.Button.TextButton"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/od_space_8"
                            android:minHeight="@dimen/od_touch_min"
                            android:text="@string/shell_remote_details" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>

            <include
                android:id="@+id/railCollapseRow"
                layout="@layout/item_rail_destination"
                android:layout_width="match_parent"
                android:layout_height="@dimen/shell_rail_footer_row_height"
                android:layout_marginBottom="@dimen/od_space_2" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/shellStage"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Sub-page header: visible only on nested destinations. -->
            <com.google.android.material.appbar.AppBarLayout
                android:id="@+id/appBarLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="?android:attr/colorBackground"
                android:visibility="gone"
                app:elevation="0dp"
                app:liftOnScroll="false">

                <com.google.android.material.appbar.MaterialToolbar
                    android:id="@+id/toolbar"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/od_subpage_header_height"
                    android:background="?android:attr/colorBackground"
                    app:contentInsetStart="@dimen/page_padding_horizontal"
                    app:titleTextAppearance="@style/TextAppearance.Overdrive.PageTitle" />
            </com.google.android.material.appbar.AppBarLayout>

            <androidx.fragment.app.FragmentContainerView
                android:id="@+id/navHostFragment"
                android:name="androidx.navigation.fragment.NavHostFragment"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                app:defaultNavHost="true"
                app:navGraph="@navigation/nav_graph" />
        </LinearLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
