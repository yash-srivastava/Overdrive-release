<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings, landscape: 236dp sub-rail | hairline | detail pane (settingsContent).
  SettingsFragment keys this branch on settingsContent, which only exists in this variant.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:baselineAligned="false"
    android:orientation="horizontal">

    <LinearLayout
        android:id="@+id/settingsSubrailContainer"
        android:layout_width="@dimen/set_subrail_width"
        android:layout_height="match_parent"
        android:background="?android:attr/colorBackground"
        android:contentDescription="@string/cd_settings_subrail"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/od_space_12"
        android:paddingTop="14dp"
        android:paddingBottom="14dp">

        <TextView
            android:id="@+id/subrailHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:paddingStart="@dimen/set_subrail_row_padding_start"
            android:paddingTop="@dimen/od_space_4"
            android:paddingEnd="@dimen/set_subrail_row_padding_start"
            android:paddingBottom="10dp"
            android:text="@string/settings_subrail_overline"
            android:textAppearance="@style/TextAppearance.Overdrive.Overline" />

        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:fillViewport="true"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/subrailRowsContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </androidx.core.widget.NestedScrollView>
    </LinearLayout>

    <View
        android:layout_width="@dimen/od_hairline"
        android:layout_height="match_parent"
        android:background="?attr/colorOutlineVariant" />

    <FrameLayout
        android:id="@+id/settingsContent"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1" />
</LinearLayout>
