<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Trip Briefing: the car-start "Heading to work? Want directions?" prompt. The spoken line is
         greeting + heading + duration (or one extra that replaces it) + question, joined by spaces,
         and read aloud by text-to-speech. -->
    <string name="trip_briefing_greeting_morning">Bon dia.</string>
    <string name="trip_briefing_greeting_afternoon">Bona tarda.</string>
    <string name="trip_briefing_greeting_evening">Bon vespre.</string>
    <string name="trip_briefing_heading_home">Aneu cap a casa?</string>
    <string name="trip_briefing_heading_work">Aneu a la feina?</string>
    <!-- %1$s: the place's name, e.g. "Phoenix Mall". -->
    <string name="trip_briefing_heading_place">Aneu a %1$s?</string>
    <plurals name="trip_briefing_duration">
        <item quantity="one">Aproximadament %1$d minut.</item>
        <item quantity="other">Uns %1$d minuts.</item>
    </plurals>
    <!-- %1$s: range left, %2$s: the trip's length, each "31 km" or "19 mi". -->
    <string name="trip_briefing_extra_range">Autonomia justa: queden %1$s per a un trajecte de %2$s.</string>
    <plurals name="trip_briefing_extra_hazards">
        <item quantity="one">%1$d perill nou a la ruta.</item>
        <item quantity="other">%1$d perills nous a la ruta.</item>
    </plurals>
    <!-- %1$s: an hour of the day in the device's clock format, e.g. "7 PM" or "19:00". -->
    <string name="trip_briefing_extra_rain">És probable que plogui cap a les %1$s.</string>
    <string name="trip_briefing_question">Voleu indicacions?</string>
    <string name="trip_briefing_distance_km">%1$d km</string>
    <string name="trip_briefing_distance_mi">%1$d mi</string>

    <!-- The destination as the AI assistant should say it. -->
    <string name="trip_briefing_said_home">casa</string>
    <string name="trip_briefing_said_work">feina</string>

    <!-- Card -->
    <string name="trip_briefing_title_home">Casa</string>
    <string name="trip_briefing_title_work">Feina</string>
    <!-- Title for a regular destination that has no name yet. -->
    <string name="trip_briefing_title_unnamed">El vostre destí habitual</string>
    <string name="trip_briefing_name_place">Anomena el lloc</string>
    <string name="trip_briefing_no">No</string>
    <string name="trip_briefing_go_failed">No s\'han iniciat les indicacions. Obre el mapa per navegar.</string>
    <!-- The car's own navigation app. -->
    <string name="trip_briefing_app_car">GPS del cotxe</string>
</resources>
