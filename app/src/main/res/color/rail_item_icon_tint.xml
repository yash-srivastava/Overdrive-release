<?xml version="1.0" encoding="utf-8"?>
<!--
  Rail icon colour. Selected uses colorPrimary rather than the canonical
  colorOnPrimaryContainer, which inverts to near-black in the light theme —
  the icon should read green in both.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="?attr/colorPrimary" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
