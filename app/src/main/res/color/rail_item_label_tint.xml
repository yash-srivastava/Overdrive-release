<?xml version="1.0" encoding="utf-8"?>
<!--
  Rail label colour. colorOnSurface when selected, leaving colorPrimary to the
  icon so the row carries a single accent.
-->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_selected="true" android:color="?attr/colorOnSurface" />
    <item android:color="?attr/colorOnSurfaceVariant" />
</selector>
