<?xml version="1.0" encoding="utf-8"?>
<!-- Recordings, portrait: counts + actions, collapsible place search, scrollable source segments,
     date control + filters, then the inline quick-filter chips over a single-column library. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <!-- Row 1: counts, search toggle, Select, settings. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:minHeight="@dimen/rec_header_row_height"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/od_page_padding_h"
            android:paddingTop="@dimen/rec_header_padding_top">

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <TextView
                    android:id="@+id/tvRecordingsSummary"
                    style="@style/Widget.Overdrive.Rec.Summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/recordings_summary_pending"
                    tools:text="12 today · 148 total · 21.4 GB" />

                <View
                    android:id="@+id/tvRecordingsSummarySkeleton"
                    android:layout_width="@dimen/rec_skeleton_summary_width"
                    android:layout_height="@dimen/rec_skeleton_summary_height"
                    android:layout_gravity="start|center_vertical"
                    android:background="@drawable/skeleton_block"
                    android:visibility="gone" />
            </FrameLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTogglePlaceSearch"
                style="@style/Widget.Overdrive.Rec.HeaderIcon"
                android:layout_width="@dimen/od_touch_min"
                android:layout_height="@dimen/od_touch_min"
                android:layout_marginStart="@dimen/od_space_8"
                android:contentDescription="@string/recording_lib_place_search_hint"
                app:icon="@drawable/ic_nav_search" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSelectRecordings"
                style="@style/Widget.Overdrive.Rec.TonalPill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/od_space_8"
                android:contentDescription="@string/recording_library_select"
                android:text="@string/rec_action_select"
                app:icon="@drawable/ic_check_circle" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFactoryDvr"
                style="@style/Widget.Overdrive.Rec.HeaderIcon"
                android:layout_width="@dimen/od_touch_min"
                android:layout_height="@dimen/od_touch_min"
                android:layout_marginStart="@dimen/od_space_8"
                android:contentDescription="@string/factory_dvr_open"
                android:tooltipText="@string/factory_dvr_open"
                app:icon="@drawable/ic_sd_card" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRecordingsSettings"
                style="@style/Widget.Overdrive.Rec.HeaderIcon"
                android:layout_width="@dimen/od_touch_min"
                android:layout_height="@dimen/od_touch_min"
                android:layout_marginStart="@dimen/od_space_8"
                android:contentDescription="@string/recordings_action_settings"
                app:icon="@drawable/ic_settings" />
        </LinearLayout>

        <!-- List | Timeline. Timeline swaps the list chrome for the date pill + Live. -->
        <LinearLayout
            android:id="@+id/recViewRow"
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_touch_min"
            android:layout_marginTop="@dimen/rec_header_row_gap"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/od_page_padding_h">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/recViewToggle"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:background="@drawable/rec_pill_track"
                android:paddingHorizontal="3dp"
                android:paddingVertical="0dp"
                android:spacing="2dp"
                android:theme="@style/ThemeOverlay.Overdrive.Rec.Segments"
                app:checkedButton="@+id/btnViewList"
                app:innerCornerSize="50%"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewList"
                    style="@style/Widget.Overdrive.Rec.Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/timeline_tab_list" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnViewTimeline"
                    style="@style/Widget.Overdrive.Rec.Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:text="@string/timeline_tab_timeline" />
            </com.google.android.material.button.MaterialButtonToggleGroup>

            <View
                android:id="@+id/recTimelineHeaderSpace"
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1"
                android:visibility="gone" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTimelineDate"
                style="@style/Widget.Overdrive.Rec.FilterPill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/od_space_8"
                android:contentDescription="@string/timeline_cd_date"
                android:visibility="gone"
                app:icon="@drawable/ic_events"
                tools:text="Today · Sat 15 Nov"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnTimelineLive"
                style="@style/Widget.Overdrive.Rec.FilterPill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/od_space_8"
                android:text="@string/timeline_live"
                android:visibility="gone"
                app:icon="@drawable/tl_live_dot"
                app:iconSize="10dp"
                tools:visibility="visible" />
        </LinearLayout>

        <!-- Place search: collapsed until the search toggle opens it (or a query is active). -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardPlaceSearch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_touch_min"
            android:layout_marginHorizontal="@dimen/od_page_padding_h"
            android:layout_marginTop="@dimen/od_space_8"
            android:visibility="gone"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="@dimen/od_radius_pill_48"
            app:cardElevation="0dp"
            app:strokeWidth="0dp"
            tools:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/od_space_16">

                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_location_pin"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <EditText
                    android:id="@+id/etPlaceSearch"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_marginStart="@dimen/od_space_12"
                    android:layout_weight="1"
                    android:background="@null"
                    android:hint="@string/recording_lib_place_search_hint"
                    android:imeOptions="actionSearch"
                    android:importantForAutofill="no"
                    android:inputType="text"
                    android:maxLines="1"
                    android:singleLine="true"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <ImageButton
                    android:id="@+id/btnClearPlaceSearch"
                    style="@style/Widget.Overdrive.Rec.RowAction"
                    android:contentDescription="@string/recording_library_clear_search"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Source segments: full labels, scrolling instead of truncating when narrow. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_touch_min"
            android:layout_marginTop="@dimen/rec_header_row_gap"
            android:clipToPadding="false"
            android:fadingEdgeLength="@dimen/od_space_24"
            android:fillViewport="true"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/od_page_padding_h"
            android:requiresFadingEdge="horizontal"
            android:scrollbars="none">

            <com.google.android.material.button.MaterialButtonToggleGroup
                android:id="@+id/segmentedSource"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:background="@drawable/rec_pill_track"
                android:paddingHorizontal="3dp"
                android:paddingVertical="0dp"
                android:spacing="2dp"
                android:theme="@style/ThemeOverlay.Overdrive.Rec.Segments"
                app:checkedButton="@id/segmentAll"
                app:innerCornerSize="50%"
                app:selectionRequired="true"
                app:singleSelection="true">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segmentAll"
                    style="@style/Widget.Overdrive.Rec.Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/recordings_segment_all" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segmentDashcam"
                    style="@style/Widget.Overdrive.Rec.Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/recordings_segment_dashcam" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segmentReplays"
                    style="@style/Widget.Overdrive.Rec.Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/recordings_segment_replays" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/segmentSurveillance"
                    style="@style/Widget.Overdrive.Rec.Segment"
                    android:layout_width="wrap_content"
                    android:layout_height="48dp"
                    android:layout_weight="1"
                    android:text="@string/recordings_segment_surveillance" />
            </com.google.android.material.button.MaterialButtonToggleGroup>
        </HorizontalScrollView>

        <!-- Date control + Reset + Filters (pills inset 4dp, so rows abut for an 8dp visual gap). -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_touch_min"
            android:baselineAligned="false"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/od_page_padding_h">

            <!-- Takes the space left after Reset and Filter, so those never get squeezed. -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/rec_pill_track"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnPrevDay"
                    style="@style/Widget.Overdrive.Rec.DateArrow"
                    android:layout_width="@dimen/od_touch_min"
                    android:layout_height="48dp"
                    android:contentDescription="@string/cd_previous_day"
                    app:icon="@drawable/ic_chevron_left" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/cardDateJump"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/od_touch_min"
                    android:layout_weight="1"
                    android:clickable="true"
                    android:focusable="true"
                    app:cardBackgroundColor="@android:color/transparent"
                    app:cardCornerRadius="@dimen/od_radius_pill_48"
                    app:cardElevation="0dp"
                    app:rippleColor="?attr/colorControlHighlight"
                    app:strokeWidth="0dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:paddingStart="@dimen/od_space_12"
                        android:paddingEnd="@dimen/od_space_12">

                        <ImageView
                            android:layout_width="@dimen/od_icon_sm"
                            android:layout_height="@dimen/od_icon_sm"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_events"
                            app:tint="?attr/colorOnSurfaceVariant" />

                        <TextView
                            android:id="@+id/tvSelectedDate"
                            style="@style/Widget.Overdrive.Rec.RowTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/od_space_6"
                            android:ellipsize="end"
                            android:maxWidth="160dp"
                            tools:text="Today" />

                        <TextView
                            android:id="@+id/tvDayClipCount"
                            style="@style/Widget.Overdrive.Rec.RowTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/od_space_6"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:visibility="gone"
                            tools:text="12"
                            tools:visibility="visible" />

                        <ImageButton
                            android:id="@+id/btnClearDate"
                            style="@style/Widget.Overdrive.Rec.RowAction"
                            android:layout_marginEnd="-8dp"
                            android:contentDescription="@string/cd_clear_date_filter"
                            android:src="@drawable/ic_clear"
                            android:visibility="gone"
                            tools:visibility="visible" />
                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnNextDay"
                    style="@style/Widget.Overdrive.Rec.DateArrow"
                    android:layout_width="@dimen/od_touch_min"
                    android:layout_height="48dp"
                    android:contentDescription="@string/cd_next_day"
                    app:icon="@drawable/ic_chevron_right" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterReset"
                style="@style/Widget.Overdrive.Rec.SheetReset"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/od_touch_min"
                android:layout_marginStart="@dimen/od_space_8"
                android:text="@string/recording_lib_filter_reset"
                android:visibility="gone"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnOpenRecordingFilters"
                style="@style/Widget.Overdrive.Rec.FilterPill"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginStart="@dimen/od_space_8"
                android:contentDescription="@string/recording_library_open_filters"
                android:text="@string/recording_lib_filter_button"
                app:icon="@drawable/ic_filter_list" />
        </LinearLayout>

        <!-- Quick filters per segment (Type / What + Severity / Place / This park); empty rows collapse. -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/od_page_padding_h"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/rowTypeFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/od_space_4"
                    android:visibility="gone"
                    tools:visibility="visible">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupType"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTypeNormal"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recording_lib_chip_type_normal" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipTypeProximity"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recording_lib_chip_type_proximity" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowWhatFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/od_space_4"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupWhat"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipActorAny"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/recording_lib_chip_any" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipActorPerson"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recording_lib_chip_person"
                            app:chipIcon="@drawable/ic_person"
                            app:chipIconSize="16dp"
                            app:chipIconTint="?attr/colorOnSurfaceVariant"
                            app:chipIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipActorVehicle"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recording_lib_chip_vehicle"
                            app:chipIcon="@drawable/ic_directions_car"
                            app:chipIconSize="16dp"
                            app:chipIconTint="?attr/colorOnSurfaceVariant"
                            app:chipIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipActorBike"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recording_lib_chip_bike"
                            app:chipIcon="@drawable/ic_pedal_bike"
                            app:chipIconSize="16dp"
                            app:chipIconTint="?attr/colorOnSurfaceVariant"
                            app:chipIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipActorAnimal"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recording_lib_chip_animal"
                            app:chipIcon="@drawable/ic_pets"
                            app:chipIconSize="16dp"
                            app:chipIconTint="?attr/colorOnSurfaceVariant"
                            app:chipIconVisible="true" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/scrollSeverityChips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/od_space_4"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupSeverity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleLine="true">

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSevAny"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:checked="true"
                            android:text="@string/recording_lib_chip_any" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSevAlert"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recording_lib_chip_alert"
                            app:chipIcon="@drawable/ic_warning"
                            app:chipIconSize="16dp"
                            app:chipIconTint="?attr/colorOnSurfaceVariant"
                            app:chipIconVisible="true" />

                        <com.google.android.material.chip.Chip
                            android:id="@+id/chipSevCritical"
                            style="@style/Widget.Overdrive.M3.Chip.Filter"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/recording_lib_chip_critical"
                            app:chipIcon="@drawable/ic_error"
                            app:chipIconSize="16dp"
                            app:chipIconTint="?attr/colorOnSurfaceVariant"
                            app:chipIconVisible="true" />
                    </com.google.android.material.chip.ChipGroup>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowPlaceFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/od_space_4"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/chipGroupPlace"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:chipSpacingHorizontal="6dp"
                        app:singleLine="true" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowParkingFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_8"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingTop="@dimen/od_space_4"
                    android:visibility="gone">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipParkingSession"
                        style="@style/Widget.Overdrive.M3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checkable="false"
                        android:text="@string/recording_lib_chip_parking_session"
                        app:chipIcon="@drawable/ic_parking"
                        app:chipIconSize="16dp"
                        app:chipIconTint="?attr/colorOnSurfaceVariant"
                        app:chipIconVisible="true"
                        app:closeIconVisible="true" />
                </LinearLayout>
            </LinearLayout>
        </HorizontalScrollView>

        <!-- Storage narrowing stays in the filter sheet; RecordingsFragment keeps this row hidden. -->
        <HorizontalScrollView
            android:id="@+id/rowStorageFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_4"
            android:clipToPadding="false"
            android:overScrollMode="never"
            android:paddingHorizontal="@dimen/od_page_padding_h"
            android:scrollbars="none"
            android:visibility="gone">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/od_space_8"
                    android:text="@string/recording_lib_filter_section_storage"
                    android:textAppearance="@style/TextAppearance.Overdrive.Overline" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chipGroupStorage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    app:chipSpacingHorizontal="6dp"
                    app:singleLine="true">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStorageAny"
                        style="@style/Widget.Overdrive.M3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true"
                        android:text="@string/recording_lib_chip_any" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStorageInternal"
                        style="@style/Widget.Overdrive.M3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recording_lib_storage_filter_internal" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStorageSd"
                        style="@style/Widget.Overdrive.M3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recording_lib_storage_filter_sd" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chipStorageUsb"
                        style="@style/Widget.Overdrive.M3.Chip.Filter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recording_lib_storage_filter_usb" />
                </com.google.android.material.chip.ChipGroup>
            </LinearLayout>
        </HorizontalScrollView>

        <androidx.fragment.app.FragmentContainerView
            android:id="@+id/libraryContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="@dimen/od_space_8"
            android:layout_weight="1" />

        <!-- Restoration-only host for a landscape inline player; it never prepares media here. -->
        <FrameLayout
            android:id="@+id/previewContainer"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:importantForAccessibility="noHideDescendants"
            android:visibility="gone" />

        <!-- Timeline (TimelineFragment); shown instead of the list while the view is Timeline. -->
        <FrameLayout
            android:id="@+id/timelineContainer"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:visibility="gone" />
    </LinearLayout>

    <include layout="@layout/app_toast" />
</FrameLayout>
