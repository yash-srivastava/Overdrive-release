<?xml version="1.0" encoding="utf-8"?>
<!-- Video player (inline preview and full screen). Chrome stays dark over any frame: camera views
     top-start, audio + maximise top-end, play/pause centred, timeline row at the bottom.
     topBar, quadrantBar, btnPlayPause and bottomControls fade together (VideoPlayerFragment). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/rec_player_bg">

    <com.overdrive.app.ui.view.ZoomableVideoView
        android:id="@+id/videoView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <ImageButton
        android:id="@+id/btnPlayPause"
        android:layout_width="56dp"
        android:layout_height="56dp"
        android:layout_gravity="center"
        android:background="@drawable/rec_player_glass_circle"
        android:contentDescription="@string/cd_play_pause"
        android:scaleType="center"
        android:src="@drawable/rec_ic_pause"
        app:tint="@color/rec_player_on_glass" />

    <LinearLayout
        android:id="@+id/playerLoadingContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/od_space_24">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:indeterminateTint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_12"
            android:text="@string/video_player_buffering"
            android:textColor="@color/rec_player_on_glass"
            android:textSize="14sp" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/playerErrorContainer"
        android:layout_width="320dp"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:background="@drawable/rec_player_panel"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/od_space_24"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvPlayerError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:gravity="center"
            android:text="@string/video_player_error_title"
            android:textColor="@color/rec_player_on_glass"
            android:textSize="18sp" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_8"
            android:gravity="center"
            android:text="@string/video_player_error_body"
            android:textColor="@color/rec_player_on_glass_variant"
            android:textSize="14sp" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_16"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayerRetry"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/od_touch_min"
                android:text="@string/video_player_retry"
                android:textAllCaps="false" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnPlayerErrorNext"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/od_touch_min"
                android:layout_marginStart="@dimen/od_space_8"
                android:text="@string/video_player_next"
                android:textAllCaps="false"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <!-- Top: back (full screen only), camera views, title (full screen), audio, maximise. -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:background="@drawable/rec_player_scrim_top"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/rec_player_padding"
        android:paddingTop="@dimen/rec_player_padding"
        android:paddingEnd="@dimen/rec_player_padding"
        android:paddingBottom="@dimen/od_space_16">

        <ImageButton
            android:id="@+id/btnBack"
            style="@style/Widget.Overdrive.Rec.PlayerGlassButton"
            android:layout_marginEnd="@dimen/od_space_4"
            android:contentDescription="@string/cd_back"
            android:src="@drawable/ic_back" />

        <!-- Camera views; clickable so taps in its gaps don't reach the video's gestures. -->
        <LinearLayout
            android:id="@+id/quadrantBar"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/od_touch_min"
            android:background="@drawable/rec_player_glass_pill"
            android:clickable="true"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="2dp">

            <ImageButton
                android:id="@+id/btnQuadrantAll"
                style="@style/Widget.Overdrive.Rec.PlayerQuadButton"
                android:contentDescription="@string/cd_player_quadrant_all"
                android:src="@drawable/ic_quadrant_all" />

            <ImageButton
                android:id="@+id/btnQuadrantFront"
                style="@style/Widget.Overdrive.Rec.PlayerQuadButton"
                android:contentDescription="@string/cd_player_quadrant_front"
                android:src="@drawable/ic_quadrant_front" />

            <ImageButton
                android:id="@+id/btnQuadrantRight"
                style="@style/Widget.Overdrive.Rec.PlayerQuadButton"
                android:contentDescription="@string/cd_player_quadrant_right"
                android:src="@drawable/ic_quadrant_right" />

            <ImageButton
                android:id="@+id/btnQuadrantRear"
                style="@style/Widget.Overdrive.Rec.PlayerQuadButton"
                android:contentDescription="@string/cd_player_quadrant_rear"
                android:src="@drawable/ic_quadrant_rear" />

            <ImageButton
                android:id="@+id/btnQuadrantLeft"
                style="@style/Widget.Overdrive.Rec.PlayerQuadButton"
                android:contentDescription="@string/cd_player_quadrant_left"
                android:src="@drawable/ic_quadrant_left" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/od_space_12"
            android:layout_marginEnd="@dimen/od_space_4"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:ellipsize="middle"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:shadowColor="@color/rec_thumb_text_shadow"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:text="@string/player_title_recording"
                android:textColor="@color/rec_player_on_glass"
                android:textSize="15sp" />

            <TextView
                android:id="@+id/tvMeta"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFeatureSettings="tnum"
                android:maxLines="1"
                android:shadowColor="@color/rec_thumb_text_shadow"
                android:shadowDy="1"
                android:shadowRadius="2"
                android:textColor="@color/rec_player_on_glass_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/btnMute"
            style="@style/Widget.Overdrive.Rec.PlayerGlassButton"
            android:contentDescription="@string/cd_player_mute"
            android:src="@drawable/ic_volume_off" />

        <ImageButton
            android:id="@+id/btnFullscreen"
            style="@style/Widget.Overdrive.Rec.PlayerGlassButton"
            android:contentDescription="@string/cd_player_maximize"
            android:src="@drawable/ic_fullscreen"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Bottom: event legend, then prev / time / events + scrubber / duration / next.
         The timeline row stays left-to-right so the scrubber and event markers line up. -->
    <LinearLayout
        android:id="@+id/bottomControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:background="@drawable/rec_player_scrim_bottom"
        android:orientation="vertical"
        android:paddingStart="@dimen/od_space_4"
        android:paddingTop="@dimen/od_space_16"
        android:paddingEnd="@dimen/od_space_4"
        android:paddingBottom="@dimen/od_space_2">

        <TextView
            android:id="@+id/tvEventInfo"
            style="@style/Widget.Overdrive.Rec.PlayerCaption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:paddingHorizontal="@dimen/od_space_12"
            tools:text="2 person · 1 car" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/od_touch_min"
            android:gravity="center_vertical"
            android:layoutDirection="ltr"
            android:orientation="horizontal">

            <ImageButton
                android:id="@+id/btnPrev"
                style="@style/Widget.Overdrive.Rec.PlayerTransport"
                android:contentDescription="@string/cd_player_prev"
                android:src="@drawable/ic_chevron_left"
                android:visibility="gone" />

            <TextView
                android:id="@+id/tvCurrentTime"
                style="@style/Widget.Overdrive.Rec.PlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/od_space_4"
                android:text="@string/player_time_zero" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1">

                <com.overdrive.app.ui.view.EventTimelineView
                    android:id="@+id/eventTimeline"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/rec_player_event_band"
                    android:layout_gravity="center_vertical"
                    android:layout_marginHorizontal="@dimen/rec_player_track_inset"
                    android:clickable="true"
                    android:focusable="true" />

                <SeekBar
                    android:id="@+id/seekBar"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:paddingStart="@dimen/rec_player_track_inset"
                    android:paddingEnd="@dimen/rec_player_track_inset"
                    android:progressBackgroundTint="@color/rec_player_track_inactive"
                    android:progressTint="?attr/colorPrimary"
                    android:thumbTint="?attr/colorPrimary" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvDuration"
                style="@style/Widget.Overdrive.Rec.PlayerTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/od_space_4"
                android:text="@string/player_time_zero" />

            <ImageButton
                android:id="@+id/btnNext"
                style="@style/Widget.Overdrive.Rec.PlayerTransport"
                android:contentDescription="@string/cd_player_next"
                android:src="@drawable/ic_chevron_right"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>
</FrameLayout>
