<?xml version="1.0" encoding="utf-8"?>
<!--
  Projection picker tile (idle grid). Tap casts the app; long-press opens its window/tools menu.
  The live app swaps to @drawable/projection_app_tile_live and shows the "On cluster" line.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/projectionTile"
    android:layout_width="match_parent"
    android:layout_height="112dp"
    android:layout_margin="5dp"
    android:background="@drawable/projection_app_tile_background"
    android:clickable="true"
    android:focusable="true"
    android:longClickable="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingHorizontal="8dp">

        <ImageView
            android:id="@+id/projectionTileIcon"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:importantForAccessibility="no"
            android:scaleType="fitCenter" />

        <TextView
            android:id="@+id/projectionTileLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textAppearance="@style/TextAppearance.Material3.TitleSmall"
            android:textColor="?attr/colorOnSurface" />

        <TextView
            android:id="@+id/projectionTileLive"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/projection_now_on_cluster"
            android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
            android:textColor="?attr/colorPrimary"
            android:visibility="gone" />
    </LinearLayout>

    <ImageView
        android:id="@+id/projectionTileBadge"
        android:layout_width="28dp"
        android:layout_height="28dp"
        android:layout_gravity="top|end"
        android:layout_margin="6dp"
        android:background="@drawable/projection_cast_badge"
        android:importantForAccessibility="no"
        android:padding="6dp"
        android:src="@drawable/ic_projection"
        app:tint="?attr/colorOnSurfaceVariant" />
</FrameLayout>
