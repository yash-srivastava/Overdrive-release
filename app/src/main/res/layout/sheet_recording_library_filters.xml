<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/colorSurface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="8dp"
        android:paddingBottom="20dp">

        <View
            android:layout_width="32dp"
            android:layout_height="4dp"
            android:layout_gravity="center_horizontal"
            android:layout_marginBottom="12dp"
            android:background="@drawable/recording_lib_drag_handle" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingBottom="8dp">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:fontFamily="sans-serif-medium"
                android:text="@string/recording_lib_filter_sheet_title"
                android:textColor="?attr/colorOnSurface"
                android:textSize="18sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnFilterReset"
                style="@style/Widget.Overdrive.M3.Button.Outlined"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:text="@string/recording_lib_filter_reset"
                android:textAllCaps="false" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheetTypeSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="8dp"
                android:paddingBottom="6dp"
                android:text="@string/recording_lib_filter_section_type"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/typeChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeNormal"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_type_normal" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipTypeProximity"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_type_proximity" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheetActorSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="@string/recording_lib_filter_section_what"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/actorChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActorAny"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_any" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActorPerson"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_person"
                    app:chipIcon="@drawable/ic_person"
                    app:chipIconSize="16dp"
                    app:chipIconTint="?attr/colorOnSurfaceVariant"
                    app:chipIconVisible="true" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActorVehicle"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_vehicle"
                    app:chipIcon="@drawable/ic_directions_car"
                    app:chipIconSize="16dp"
                    app:chipIconTint="?attr/colorOnSurfaceVariant"
                    app:chipIconVisible="true" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActorBike"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_bike"
                    app:chipIcon="@drawable/ic_pedal_bike"
                    app:chipIconSize="16dp"
                    app:chipIconTint="?attr/colorOnSurfaceVariant"
                    app:chipIconVisible="true" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipActorAnimal"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_animal"
                    app:chipIcon="@drawable/ic_pets"
                    app:chipIconSize="16dp"
                    app:chipIconTint="?attr/colorOnSurfaceVariant"
                    app:chipIconVisible="true" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheetSeveritySection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="@string/recording_lib_filter_section_severity"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/severityChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSevAny"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_any" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSevAlert"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_alert"
                    app:chipIcon="@drawable/ic_warning"
                    app:chipIconSize="16dp"
                    app:chipIconTint="?attr/colorOnSurfaceVariant"
                    app:chipIconVisible="true" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipSevCritical"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_critical"
                    app:chipIcon="@drawable/ic_error"
                    app:chipIconSize="16dp"
                    app:chipIconTint="?attr/colorOnSurfaceVariant"
                    app:chipIconVisible="true" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheetPlaceSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="@string/recording_lib_filter_section_place"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/sheetPlaceChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="6dp"
                app:singleLine="false"
                app:singleSelection="true" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/sheetStorageSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="16dp"
                android:paddingBottom="6dp"
                android:text="@string/recording_lib_filter_section_storage"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/storageChipGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:chipSpacingHorizontal="8dp"
                app:singleLine="false">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStorageAny"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_chip_any" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStorageInternal"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_storage_filter_internal" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStorageSd"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_storage_filter_sd" />
                <com.google.android.material.chip.Chip
                    android:id="@+id/chipStorageUsb"
                    style="@style/Widget.Overdrive.M3.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/recording_lib_storage_filter_usb" />
            </com.google.android.material.chip.ChipGroup>
        </LinearLayout>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnFilterApply"
            style="@style/Widget.Overdrive.M3.Button"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="20dp"
            android:text="@string/recording_lib_filter_apply"
            android:textAllCaps="false"
            app:cornerRadius="8dp" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
