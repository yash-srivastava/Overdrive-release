<?xml version="1.0" encoding="utf-8"?>
<!-- Landscape library row: 96x54 thumbnail, time/type/severity, place, detail line, share + delete.
     RecordingAdapter tints the active row and the badges. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/recordingCard"
    android:layout_width="match_parent"
    android:layout_height="@dimen/rec_row_height"
    android:layout_marginVertical="@dimen/od_space_2"
    app:cardBackgroundColor="@android:color/transparent"
    app:cardCornerRadius="@dimen/od_radius_card"
    app:cardElevation="0dp"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:baselineAligned="false"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/rec_row_padding_start">

        <com.google.android.material.card.MaterialCardView
            android:layout_width="@dimen/rec_thumb_width"
            android:layout_height="@dimen/rec_thumb_height"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHigh"
            app:cardCornerRadius="@dimen/rec_thumb_radius"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <ImageView
                android:id="@+id/ivThumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:contentDescription="@string/cd_video_thumbnail"
                android:scaleType="centerCrop" />

            <View
                android:id="@+id/severityStripe"
                android:layout_width="@dimen/rec_severity_stripe"
                android:layout_height="match_parent"
                android:layout_gravity="start"
                android:visibility="gone" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="top"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/od_space_6"
                android:paddingTop="3dp"
                android:paddingEnd="3dp">

                <TextView
                    android:id="@+id/tvCameraId"
                    style="@style/Widget.Overdrive.Rec.ThumbLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    tools:text="C0" />

                <TextView
                    android:id="@+id/tvSafeKeepBadge"
                    style="@style/Widget.Overdrive.Rec.SafeKeepBadge"
                    android:layout_width="wrap_content"
                    android:visibility="gone"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDuration"
                style="@style/Widget.Overdrive.Rec.ThumbDuration"
                android:layout_width="wrap_content"
                android:layout_gravity="bottom|end"
                android:layout_margin="@dimen/od_space_4"
                tools:text="1:00" />

            <CheckBox
                android:id="@+id/cbSelect"
                android:layout_width="@dimen/od_touch_min"
                android:layout_height="@dimen/od_touch_min"
                android:layout_gravity="bottom|start"
                android:background="@drawable/rec_check_box"
                android:button="@null"
                android:visibility="gone" />
        </com.google.android.material.card.MaterialCardView>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <!-- Time, then badges: the type badge collapses first, the severity badge ellipsizes last. -->
            <com.overdrive.app.ui.widget.BadgeLine
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvRecordingTime"
                    style="@style/Widget.Overdrive.Rec.RowTime"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="08:12" />

                <com.overdrive.app.ui.widget.FitOrHideTextView
                    android:id="@+id/tvTypeBadge"
                    style="@style/Widget.Overdrive.Rec.Badge"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/od_space_6"
                    tools:text="EVENT" />

                <TextView
                    android:id="@+id/tvSeverity"
                    style="@style/Widget.Overdrive.Rec.Badge"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/od_space_6"
                    android:visibility="gone"
                    tools:text="Alert"
                    tools:visibility="visible" />
            </com.overdrive.app.ui.widget.BadgeLine>

            <TextView
                android:id="@+id/tvLocation"
                style="@style/Widget.Overdrive.Rec.RowMeta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:drawableStart="@drawable/rec_ic_pin_14"
                android:drawablePadding="@dimen/od_space_4"
                android:drawableTint="?attr/colorOnSurfaceVariant"
                android:gravity="center_vertical"
                android:visibility="invisible"
                tools:text="Orchard Rd"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvEventTitle"
                    style="@style/Widget.Overdrive.Rec.RowMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    tools:text="Motion detected" />

                <TextView
                    android:id="@+id/tvActorSummary"
                    style="@style/Widget.Overdrive.Rec.RowMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="gone"
                    tools:text="1 person · Close"
                    tools:visibility="visible" />

                <TextView
                    style="@style/Widget.Overdrive.Rec.RowMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:importantForAccessibility="no"
                    android:text="@string/rec_meta_separator" />

                <TextView
                    android:id="@+id/tvSize"
                    style="@style/Widget.Overdrive.Rec.RowMeta"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    tools:text="48 MB" />

                <TextView
                    android:id="@+id/tvStorageBadge"
                    style="@style/Widget.Overdrive.Rec.Badge.Small"
                    android:layout_width="wrap_content"
                    android:layout_marginStart="@dimen/od_space_6"
                    android:visibility="gone"
                    tools:text="SD"
                    tools:visibility="visible" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvFilename"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/btnShare"
                style="@style/Widget.Overdrive.Rec.RowAction"
                android:contentDescription="@string/cd_share"
                android:src="@drawable/ic_share" />

            <ImageButton
                android:id="@+id/btnDelete"
                style="@style/Widget.Overdrive.Rec.RowAction"
                android:contentDescription="@string/cd_delete"
                android:src="@drawable/ic_delete" />

            <!-- Kept for RecordingAdapter; landscape rows leave extra actions to the preview menu. -->
            <ImageButton
                android:id="@+id/btnMore"
                style="@style/Widget.Overdrive.Rec.RowAction"
                android:contentDescription="@string/cd_recording_more_actions"
                android:src="@drawable/ic_more_vert"
                android:visibility="gone" />
        </LinearLayout>
    </LinearLayout>

    <View
        android:id="@+id/activeIndicator"
        android:layout_width="@dimen/rec_active_marker_width"
        android:layout_height="@dimen/rec_active_marker_height"
        android:layout_gravity="start|center_vertical"
        android:background="@drawable/rec_active_marker"
        android:visibility="gone" />
</com.google.android.material.card.MaterialCardView>
