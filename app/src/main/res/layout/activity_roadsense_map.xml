<?xml version="1.0" encoding="utf-8"?>
<!--
  Full-bleed MapLibre MapView under floats: back + search pills top-start, control capsule top-end,
  zoom capsule over recenter bottom-end. Insets, widths and visibility are set in RoadSenseMapActivity.
  clipChildren=false lets the floats' shadows draw outside their parents.
-->
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/mapRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?attr/colorSurface"
    android:clipChildren="false">

    <!-- Takes the window's first focus (targetSdk 25 always assigns one) so the search
         field stays unfocused, without its recents dropdown, until it is tapped. -->
    <View
        android:id="@+id/mapFocusSink"
        android:layout_width="1dp"
        android:layout_height="1dp"
        android:defaultFocusHighlightEnabled="false"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:importantForAccessibility="no" />

    <org.maplibre.android.maps.MapView
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Google Maps logo + data copyright, shown only while the Google basemap is up.
         Margins are set at runtime next to MapLibre's own chrome (applyMapChromeInsets). -->
    <com.overdrive.app.navmap.google.GoogleAttributionView
        android:id="@+id/googleAttribution"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:visibility="gone" />

    <!-- Glass navigation HUD (maneuver card, lanes, trip bar, compass, re-centre); shown while navigating. -->
    <include layout="@layout/nav_hud" />

    <!-- Back: a 56dp floating pill (the toolbar). The code pads the bar below the status bar. -->
    <com.google.android.material.appbar.AppBarLayout
        android:id="@+id/mapAppBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/map_float_margin"
        android:layout_marginTop="@dimen/map_float_margin"
        android:background="@null"
        android:clipChildren="false"
        android:clipToPadding="false"
        app:elevation="0dp"
        app:liftOnScroll="false">

        <!-- The toolbar style hides outline shadows; the pill restores them. -->
        <com.google.android.material.appbar.MaterialToolbar
            android:id="@+id/mapToolbar"
            android:layout_width="@dimen/map_float_size"
            android:layout_height="@dimen/map_float_size"
            android:background="@drawable/map_float_surface"
            android:elevation="@dimen/map_float_elevation"
            android:outlineAmbientShadowColor="@android:color/black"
            android:outlineSpotShadowColor="@android:color/black"
            android:padding="0dp"
            app:contentInsetEnd="0dp"
            app:contentInsetStart="0dp"
            app:contentInsetStartWithNavigation="0dp"
            app:navigationContentDescription="@string/roadsense_map_back"
            app:navigationIcon="@drawable/ic_back"
            app:navigationIconTint="?attr/colorOnSurface" />
    </com.google.android.material.appbar.AppBarLayout>

    <!-- Search pill beside the back pill, with the autocomplete dropdown beneath it.
         RoadSenseMapActivity sets the width (clear of the end capsule) and the top inset. -->
    <LinearLayout
        android:id="@+id/navSearchColumn"
        android:layout_width="@dimen/map_search_max_width"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/map_search_inset"
        android:layout_marginTop="@dimen/map_float_margin"
        android:clipChildren="false"
        android:clipToPadding="false"
        android:orientation="vertical">

        <!-- Leading search glyph (submit), the input, and a clear (X) shown only when non-empty. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/navSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="28dp"
            app:cardElevation="@dimen/map_float_elevation"
            app:strokeWidth="0dp"
            app:cardBackgroundColor="?attr/colorSurfaceContainerHighest">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/map_float_size"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="8dp"
                android:paddingEnd="4dp">

                <ImageButton
                    android:id="@+id/navSearchButton"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/roadsense_map_search_action"
                    android:padding="12dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_nav_search"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <EditText
                    android:id="@+id/navSearchInput"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@android:color/transparent"
                    android:gravity="center_vertical"
                    android:hint="@string/roadsense_map_search_hint"
                    android:imeOptions="actionSearch"
                    android:inputType="text"
                    android:maxLines="1"
                    android:paddingHorizontal="4dp"
                    android:textColor="?attr/colorOnSurface"
                    android:textColorHint="?attr/colorOnSurfaceVariant"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:importantForAutofill="no"
                    tools:ignore="Autofill" />

                <ImageButton
                    android:id="@+id/navSearchClear"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:background="?attr/selectableItemBackgroundBorderless"
                    android:contentDescription="@string/roadsense_map_clear_search"
                    android:padding="13dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_clear"
                    android:visibility="gone"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Autocomplete dropdown — a rounded surface card holding a
             RecyclerView of search-result rows. The geocoder is capped at 6
             suggestions so the card never grows past ~6 short rows; it scrolls
             internally if needed. Animated in/out + hidden when empty by the
             Activity. nestedScrollingEnabled is left on so it scrolls inside
             the card without dragging the map. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/navSearchDropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:visibility="gone"
            app:cardCornerRadius="24dp"
            app:cardElevation="1dp"
            app:strokeWidth="1dp"
            app:strokeColor="?attr/colorOutlineVariant"
            app:cardBackgroundColor="?attr/colorSurfaceContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Saved-place quick chips (Home / Work / custom favourites). Shown
                     only when the search field is empty + focused; populated in code
                     by RoadSenseMapActivity.showRecentSearches() → buildSavedChips().
                     Tapping a chip routes there; tapping an unset Home/Work chip
                     prompts to set it. Horizontally scrollable so many custom
                     favourites stay reachable. -->
                <HorizontalScrollView
                    android:id="@+id/navSavedScroll"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="12dp"
                    android:paddingTop="12dp"
                    android:paddingBottom="4dp"
                    android:scrollbars="none"
                    android:visibility="gone">

                    <com.google.android.material.chip.ChipGroup
                        android:id="@+id/navSavedChips"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        app:singleLine="true"
                        app:chipSpacingHorizontal="8dp" />
                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/navSearchResults"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:clipToPadding="false"
                    android:overScrollMode="ifContentScrolls"
                    android:paddingVertical="8dp"
                    android:scrollbars="vertical"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_nav_search_result" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>

    <!-- Turn-by-turn maneuver banner — top card shown only while navigating.
         Primary = next instruction + distance; secondary = remaining + ETA. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/navBanner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="top"
        android:layout_marginHorizontal="12dp"
        android:layout_marginTop="64dp"
        android:visibility="gone"
        app:cardCornerRadius="24dp"
        app:cardElevation="2dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardBackgroundColor="?attr/colorPrimaryContainer">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingVertical="14dp">

            <!-- Maneuver turn glyph — set per RouteManeuver.type. GONE until a
                 maneuver resolves so the banner doesn't show a stale arrow. -->
            <ImageView
                android:id="@+id/navBannerIcon"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_marginEnd="16dp"
                android:visibility="gone"
                android:contentDescription="@null"
                app:tint="?attr/colorOnPrimaryContainer"
                tools:src="@drawable/ic_man_turn_right"
                tools:visibility="visible" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/navBannerPrimary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:maxLines="2"
                    android:ellipsize="end"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    tools:text="300 m • Turn right onto Main St" />

                <TextView
                    android:id="@+id/navBannerSecondary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="3dp"
                    android:alpha="0.85"
                    android:textColor="?attr/colorOnPrimaryContainer"
                    android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                    tools:text="4.2 km • 9 min" />
            </LinearLayout>
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Immersive-nav back affordance — the toolbar (with its back chevron) is
         hidden in immersive driving view, so this top-START FAB restores a way
         out (exits the map Activity). Shown only during immersive nav on the
         infotainment instance; never on the non-touch cluster. A tonal circular
         FAB over the same top scrim as the toolbar so it reads on any basemap. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabNavBack"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="16dp"
        android:layout_marginTop="16dp"
        android:visibility="gone"
        android:contentDescription="@string/roadsense_map_back"
        android:src="@drawable/ic_back"
        app:fabSize="mini"
        app:backgroundTint="?attr/colorSurfaceContainerHighest"
        app:tint="?attr/colorOnSurface"
        app:elevation="0dp"
        app:pressedTranslationZ="0dp"
        android:stateListAnimator="@null"
        tools:ignore="ImageContrastCheck" />

    <!-- End-navigation FAB — bottom-START (clear of the end-side zoom + locate
         stack), shown only while navigating. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabEndNav"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="24dp"
        android:layout_marginBottom="24dp"
        android:visibility="gone"
        android:contentDescription="@string/roadsense_map_end_nav"
        android:src="@drawable/ic_nav_close"
        app:backgroundTint="?attr/colorErrorContainer"
        app:tint="?attr/colorOnErrorContainer"
        app:elevation="0dp"
        app:pressedTranslationZ="0dp"
        android:stateListAnimator="@null"
        tools:ignore="ImageContrastCheck" />

    <!-- Recenter: a 56dp round float at bottom-end, under the zoom capsule. -->
    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fabLocate"
        style="@style/Widget.Overdrive.Map.FloatButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/map_float_margin"
        android:layout_marginBottom="@dimen/map_float_margin"
        android:contentDescription="@string/roadsense_map_recenter"
        android:src="@drawable/ic_my_location"
        tools:ignore="ImageContrastCheck" />

    <!-- Top-end capsule: hazard filter, charging/fuel, map layers, theme, 2D/3D. Flat 56dp
         buttons with hairlines between the visible ones; toggles tint their button when on. -->
    <LinearLayout
        android:id="@+id/mapControlsTop"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginEnd="@dimen/map_float_margin"
        android:layout_marginTop="@dimen/map_float_margin"
        android:background="@drawable/map_float_surface"
        android:divider="@drawable/map_capsule_divider"
        android:elevation="@dimen/map_float_elevation"
        android:orientation="vertical"
        android:showDividers="middle">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabHazardFilter"
            style="@style/Widget.Overdrive.Map.CapsuleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/roadsense_map_hazards_filter"
            android:src="@drawable/ic_hazard_filter"
            tools:ignore="ImageContrastCheck" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabPoi"
            style="@style/Widget.Overdrive.Map.CapsuleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/roadsense_map_poi_toggle"
            android:src="@drawable/ic_poi_pin"
            tools:ignore="ImageContrastCheck" />

        <!-- Google map type + live traffic picker; shown only when a Google key is usable. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMapLayers"
            style="@style/Widget.Overdrive.Map.CapsuleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/navmap_google_layers_cd"
            android:src="@drawable/ic_map_layers"
            android:visibility="gone"
            tools:ignore="ImageContrastCheck" />

        <!-- Map scheme Auto / Light / Dark; the icon follows the mode. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMapTheme"
            style="@style/Widget.Overdrive.Map.CapsuleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/roadsense_map_theme_toggle"
            android:src="@drawable/ic_map_theme_auto"
            tools:ignore="ImageContrastCheck" />

        <!-- 2D / 3D buildings; hidden on the Google basemap. -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabMap3d"
            style="@style/Widget.Overdrive.Map.CapsuleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/roadsense_map_dimension_toggle"
            android:src="@drawable/ic_map_3d"
            tools:ignore="ImageContrastCheck" />
    </LinearLayout>

    <!-- Bottom-end zoom capsule above the recenter button. -->
    <LinearLayout
        android:id="@+id/zoomControls"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="@dimen/map_float_margin"
        android:layout_marginBottom="@dimen/map_zoom_bottom"
        android:background="@drawable/map_float_surface"
        android:divider="@drawable/map_capsule_divider"
        android:elevation="@dimen/map_float_elevation"
        android:orientation="vertical"
        android:showDividers="middle">

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabZoomIn"
            style="@style/Widget.Overdrive.Map.CapsuleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/roadsense_map_zoom_in"
            android:src="@drawable/ic_zoom_in"
            tools:ignore="ImageContrastCheck" />

        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabZoomOut"
            style="@style/Widget.Overdrive.Map.CapsuleButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:contentDescription="@string/roadsense_map_zoom_out"
            android:src="@drawable/ic_zoom_out"
            tools:ignore="ImageContrastCheck" />
    </LinearLayout>

    <!-- ROUTE-OPTIONS SHEET — a persistent collapsible bottom sheet (driven by
         BottomSheetBehavior) shown after a destination is chosen and the
         alternates are computed. The map STAYS interactive behind it so the
         user can tap an alternate's line to select it. Lists each candidate
         route (label / distance / ETA / fastest hint) over a "Start" primary
         button and a "Cancel" affordance. Hidden (peekHeight 0 + GONE via the
         Activity) until routes are ready, and torn down when guidance starts
         or the user cancels. -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/routeOptionsSheet"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:cardBackgroundColor="?attr/colorSurfaceContainer"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:strokeWidth="1dp"
        app:strokeColor="?attr/colorOutlineVariant"
        app:cardPreventCornerOverlap="false"
        app:behavior_hideable="true"
        app:behavior_peekHeight="220dp"
        app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Overdrive.RouteSheet">

        <LinearLayout
            android:id="@+id/routeSheetContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingTop="10dp"
            android:paddingBottom="20dp">

            <!-- Drag handle -->
            <View
                android:layout_width="36dp"
                android:layout_height="4dp"
                android:layout_gravity="center_horizontal"
                android:layout_marginBottom="14dp"
                android:background="@drawable/sheet_drag_handle" />

            <!-- Header row: title + close affordance -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="20dp"
                android:paddingEnd="10dp">

                <TextView
                    android:id="@+id/tvRouteSheetTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:ellipsize="end"
                    android:singleLine="true"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="?attr/colorOnSurface"
                    android:text="@string/roadsense_map_routes_title"
                    tools:text="Routes to Changi Airport" />

                <ImageButton
                    android:id="@+id/btnRouteCarNav"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_nav_leading_icon"
                    android:contentDescription="@string/carnav_section_header"
                    android:padding="8dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_directions_car"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/btnRouteSheetSave"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:layout_marginEnd="4dp"
                    android:background="@drawable/bg_nav_leading_icon"
                    android:contentDescription="@string/roadsense_map_save_place"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_star"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <ImageButton
                    android:id="@+id/btnRouteSheetClose"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_nav_leading_icon"
                    android:contentDescription="@string/roadsense_map_routes_cancel"
                    android:padding="9dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_clear"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>

            <!-- Scrollable middle: itinerary + route candidates. Header (above) and
                 the Start button (below) stay pinned; only this region scrolls when
                 there are many routes, so the header car icon never scrolls off-screen.
                 Its height is capped in code (RoadSenseMapActivity.showRouteOptionsSheet)
                 so the whole sheet fits the short landscape screen; short content keeps
                 the sheet compact (wrap_content). -->
            <androidx.core.widget.NestedScrollView
                android:id="@+id/routeSheetScroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fillViewport="true"
                android:overScrollMode="ifContentScrolls">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- TRIP STOPS — the ordered itinerary (origin → intermediate stops →
                         destination) plus an "Add stop" affordance. Rebuilt in code by
                         RoadSenseMapActivity.rebuildStopsUi() into this LinearLayout: an
                         origin row ("Your location"), one row per entry in routeStops
                         (each with a remove X + up/down reorder controls), and an
                         "Add stop" row at the end. Kept as a code-populated container
                         (not a RecyclerView) since the list is tiny (≤ MAX_STOPS). -->
                    <LinearLayout
                        android:id="@+id/routeStopsContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:orientation="vertical" />

                    <!-- Thin divider between the itinerary and the route candidates. -->
                    <View
                        android:id="@+id/routeStopsDivider"
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginVertical="8dp"
                        android:background="?attr/colorOutlineVariant" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/routeOptionsList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:clipToPadding="false"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:paddingVertical="2dp"
                        tools:itemCount="2"
                        tools:listitem="@layout/item_nav_route_option" />

                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <!-- Routing provider credit; set by showRouteOptionsSheet, gone without Google. -->
            <TextView
                android:id="@+id/tvRouteProvider"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="10dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="12sp"
                android:visibility="gone"
                tools:text="Routes by Google"
                tools:visibility="visible" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnRouteStart"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="20dp"
                android:layout_marginTop="14dp"
                android:fontFamily="sans-serif-medium"
                android:paddingVertical="16dp"
                android:text="@string/roadsense_map_start"
                android:textSize="16sp"
                app:cornerRadius="20dp"
                app:icon="@drawable/ic_directions_car"
                app:iconGravity="textStart"
                app:iconPadding="10dp" />

            <!-- "Send to car navigation" lives as a header icon (btnRouteCarNav) so it
                 stays visible; the old bottom buttons scrolled off the short screen. -->
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

</androidx.coordinatorlayout.widget.CoordinatorLayout>
