<?xml version="1.0" encoding="utf-8"?>
<!-- Settings sub-rail row (52dp). SettingsFragment shows the chevron only on sections that navigate. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="@dimen/set_subrail_row_height"
    android:background="@drawable/set_subrail_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="@dimen/set_subrail_row_padding_start"
    android:paddingEnd="@dimen/set_subrail_row_padding_end">

    <ImageView
        android:id="@+id/subrailRowIcon"
        android:layout_width="@dimen/od_icon_md"
        android:layout_height="@dimen/od_icon_md"
        android:contentDescription="@null"
        app:tint="@color/settings_subrail_icon" />

    <TextView
        android:id="@+id/subrailRowLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="14dp"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
        android:textColor="@color/settings_subrail_label" />

    <ImageView
        android:id="@+id/subrailRowChevron"
        android:layout_width="@dimen/od_icon_sm"
        android:layout_height="@dimen/od_icon_sm"
        android:layout_marginStart="@dimen/od_space_8"
        android:contentDescription="@null"
        android:src="@drawable/ic_chevron_right"
        android:visibility="gone"
        app:tint="?attr/colorOnSurfaceVariant" />
</LinearLayout>
