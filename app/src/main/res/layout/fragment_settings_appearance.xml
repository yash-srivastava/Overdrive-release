<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › Appearance. The pin grid column count follows the window width (@integer/set_nav_columns). -->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/od_page_padding_h"
        android:paddingTop="18dp"
        android:paddingBottom="@dimen/od_space_24">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:accessibilityHeading="true"
            android:text="@string/settings_section_appearance"
            android:textAppearance="@style/TextAppearance.Overdrive.PageTitle" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_2"
            android:text="@string/settings_appearance_subtitle"
            android:textAppearance="@style/TextAppearance.Overdrive.Settings.Lede" />

        <!-- Theme -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_theme_label"
                    android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle" />

                <LinearLayout
                    android:id="@+id/themeToggleGroup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="14dp"
                    android:baselineAligned="false"
                    android:orientation="horizontal">

                    <FrameLayout
                        android:id="@+id/themeAuto"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/set_theme_gap_half"
                        android:layout_weight="1"
                        android:background="@drawable/set_theme_tile_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="@dimen/od_space_12">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/set_theme_preview_height"
                                android:background="@drawable/set_theme_pv_auto"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/settings_theme_auto_short"
                                android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/themeLight"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/set_theme_gap_half"
                        android:layout_weight="1"
                        android:background="@drawable/set_theme_tile_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="@dimen/od_space_12">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/set_theme_preview_height"
                                android:background="@drawable/set_theme_pv_light"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/settings_theme_light"
                                android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </FrameLayout>

                    <FrameLayout
                        android:id="@+id/themeDark"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/set_theme_gap_half"
                        android:layout_weight="1"
                        android:background="@drawable/set_theme_tile_bg"
                        android:clickable="true"
                        android:focusable="true">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="vertical"
                            android:paddingHorizontal="10dp"
                            android:paddingTop="10dp"
                            android:paddingBottom="@dimen/od_space_12">

                            <View
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/set_theme_preview_height"
                                android:background="@drawable/set_theme_pv_dark"
                                android:importantForAccessibility="no" />

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="10dp"
                                android:ellipsize="end"
                                android:gravity="center"
                                android:maxLines="1"
                                android:text="@string/settings_theme_dark"
                                android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </FrameLayout>
                </LinearLayout>

                <!-- Text set per mode by SettingsAppearanceFragment. -->
                <TextView
                    android:id="@+id/tvThemeActiveCaption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/od_space_12"
                    android:text="@string/settings_theme_active_auto_caption"
                    android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Display language -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardLanguage"
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:clickable="true"
            android:focusable="true"
            app:contentPaddingBottom="@dimen/od_space_2"
            app:contentPaddingTop="@dimen/od_space_2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/set_row_link_min_height"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_language"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="14dp"
                    android:layout_marginEnd="14dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_language_card_title"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="1dp"
                        android:baselineAligned="false"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/tvLanguageValue"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />

                        <TextView
                            android:id="@+id/tvLanguageCount"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/od_space_6"
                            android:layout_weight="1"
                            android:drawableStart="@drawable/set_meta_dot"
                            android:drawablePadding="@dimen/od_space_6"
                            android:ellipsize="end"
                            android:maxLines="1"
                            android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Navigation pinning -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:accessibilityHeading="true"
                    android:text="@string/settings_navigation_title"
                    android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/od_space_4"
                    android:text="@string/settings_navigation_subtitle"
                    android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />

                <!-- Rows are added by SettingsAppearanceFragment. -->
                <GridLayout
                    android:id="@+id/navigationOptionsContainer"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/od_space_4"
                    android:columnCount="@integer/set_nav_columns"
                    android:orientation="horizontal"
                    android:useDefaultMargins="false" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/od_space_8"
                    android:baselineAligned="false"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="@string/settings_navigation_fixed_hint"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/navigationResetButton"
                        style="@style/Widget.Overdrive.M3.Button.Text"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_12"
                        android:text="@string/settings_navigation_reset" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
