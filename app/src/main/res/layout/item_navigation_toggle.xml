<?xml version="1.0" encoding="utf-8"?>
<!-- Navigation pin row. The row owns the click; the switch only mirrors state. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:minHeight="@dimen/od_touch_standard"
    android:paddingVertical="@dimen/od_space_4"
    android:background="@drawable/set_nav_row_bg"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/navigationOptionIcon"
        android:layout_width="@dimen/set_nav_icon"
        android:layout_height="@dimen/set_nav_icon"
        android:contentDescription="@null"
        app:tint="?attr/colorOnSurfaceVariant" />

    <TextView
        android:id="@+id/navigationOptionLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/od_space_12"
        android:layout_marginEnd="@dimen/od_space_12"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="2"
        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
        android:textSize="14sp" />

    <com.google.android.material.materialswitch.MaterialSwitch
        android:id="@+id/navigationOptionSwitch"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/od_touch_min"
        android:clickable="false"
        android:focusable="false" />
</LinearLayout>
