<?xml version="1.0" encoding="utf-8"?>
<!--
  Per-app actions, opened by long-pressing an app tile (or tapping the app already on the
  cluster). Everything that belongs to ONE app lives here: its saved cluster window (presets +
  free resize), its tools, its favorite flag, and casting it. Settings shared by every app stay
  in the Projection settings panel.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="24dp"
        android:paddingTop="20dp"
        android:paddingBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/projectionActionsIcon"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:importantForAccessibility="no"
                android:scaleType="fitCenter" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="16dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/projectionActionsTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textColor="?attr/colorOnSurface" />

                <TextView
                    android:id="@+id/projectionActionsSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/projection_actions_window_saved"
                    android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                    android:textColor="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/projection_window_title"
            android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
            android:textColor="?attr/colorOnSurfaceVariant" />

        <com.google.android.material.button.MaterialButtonToggleGroup
            android:id="@+id/projectionActionsPresets"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:singleSelection="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/projectionActionsPresetFull"
                style="@style/Widget.Overdrive.M3.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/dashboard_modern_touch_target"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="@string/projection_preset_full"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/projectionActionsPresetLeft"
                style="@style/Widget.Overdrive.M3.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/dashboard_modern_touch_target"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="@string/projection_preset_left"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/projectionActionsPresetRight"
                style="@style/Widget.Overdrive.M3.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/dashboard_modern_touch_target"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="@string/projection_preset_right"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/projectionActionsPresetCenter"
                style="@style/Widget.Overdrive.M3.Button.Outlined"
                android:layout_width="0dp"
                android:layout_height="@dimen/dashboard_modern_touch_target"
                android:layout_weight="1"
                android:maxLines="1"
                android:paddingHorizontal="4dp"
                android:text="@string/projection_preset_center"
                app:autoSizeMaxTextSize="14sp"
                app:autoSizeMinTextSize="10sp"
                app:autoSizeTextType="uniform" />
        </com.google.android.material.button.MaterialButtonToggleGroup>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="4dp"
            android:background="?attr/colorOutlineVariant" />

        <include
            android:id="@+id/projectionActionsResize"
            layout="@layout/item_projection_action_row" />

        <include
            android:id="@+id/projectionActionsTools"
            layout="@layout/item_projection_action_row" />

        <include
            android:id="@+id/projectionActionsFavorite"
            layout="@layout/item_projection_action_row" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/projectionActionsPrimary"
            style="@style/Widget.Overdrive.M3.Button.Icon"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="12dp"
            android:text="@string/projection_cast"
            app:icon="@drawable/ic_projection"
            app:iconGravity="textStart" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
