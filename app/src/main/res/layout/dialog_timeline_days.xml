<?xml version="1.0" encoding="utf-8"?>
<!-- Timeline day picker (date pill): a month grid; the weekday labels and day cells are added in code. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:accessibilityPaneTitle="@string/timeline_cd_date"
    android:overScrollMode="never"
    android:scrollbars="none">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/od_space_16"
        android:paddingTop="@dimen/od_space_12"
        android:paddingEnd="@dimen/od_space_16"
        android:paddingBottom="@dimen/od_space_8">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tlDaysMonth"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:accessibilityHeading="true"
                android:accessibilityLiveRegion="polite"
                android:ellipsize="end"
                android:maxLines="1"
                android:paddingStart="@dimen/od_space_8"
                android:paddingEnd="@dimen/od_space_8"
                android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                android:textColor="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/tlDaysPrev"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/timeline_day_prev_month"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_left" />

            <ImageButton
                android:id="@+id/tlDaysNext"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/timeline_day_next_month"
                android:scaleType="center"
                android:src="@drawable/ic_chevron_right" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tlDaysWeekdays"
            android:layout_width="match_parent"
            android:layout_height="32dp"
            android:importantForAccessibility="noHideDescendants"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/tlDaysGrid"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:layout_marginTop="@dimen/od_space_4"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center_vertical"
                android:importantForAccessibility="noHideDescendants"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tlDaysLegendFootage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="@dimen/od_space_6"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:paddingStart="@dimen/od_space_8"
                    android:text="@string/timeline_day_legend_footage"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/tlDaysLegendAlerts"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_16"
                    android:drawablePadding="@dimen/od_space_6"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:text="@string/timeline_filter_alerts"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="15sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/tlDaysCancel"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="56dp"
                android:layout_marginStart="@dimen/od_space_8"
                android:insetTop="0dp"
                android:insetBottom="0dp"
                android:minWidth="88dp"
                android:text="@android:string/cancel"
                android:textSize="16sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
