<?xml version="1.0" encoding="utf-8"?>
<!--
  Compact app chip for the "Switch app" strip under the live mirror, on the shared Revamp tile
  (76dp touch target). Long-press opens the same window/tools menu as the idle tiles.
-->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/projectionTile"
    style="@style/Widget.Overdrive.Revamp.Tile"
    android:layout_width="@dimen/od_touch_primary"
    android:layout_height="@dimen/od_touch_primary"
    android:layout_marginEnd="@dimen/od_space_8"
    android:longClickable="true">

    <ImageView
        android:id="@+id/projectionTileIcon"
        android:layout_width="@dimen/od_icon_tile"
        android:layout_height="@dimen/od_icon_tile"
        android:layout_gravity="center"
        android:importantForAccessibility="no"
        android:scaleType="fitCenter" />
</com.google.android.material.card.MaterialCardView>
