<?xml version="1.0" encoding="utf-8"?>
<!--
  Settings, portrait hub (the landscape variant is the sub-rail two-pane layout).
  Order: subtitle, Theme/Language tiles, Preferences rows, status overlay, remote
  communication, Security, Daemons, Reset data, footer. SettingsFragment wires every id here.
-->
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="?android:attr/colorBackground"
    android:clipToPadding="false"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/od_page_padding_h"
        android:paddingTop="@dimen/od_page_padding_top"
        android:paddingBottom="@dimen/od_space_24">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/od_space_12"
            android:text="@string/settings_hero_subtitle"
            android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="15sp" />

        <!-- Theme opens the picker dialog; Language opens LanguagePickerDialog. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:baselineAligned="false"
            android:orientation="horizontal">

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/quickTileTheme"
                style="@style/Widget.Overdrive.Revamp.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/int_grid_gap_half"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/od_touch_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/od_icon_md"
                        android:layout_height="@dimen/od_icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_dashboard"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_12"
                        android:text="@string/settings_quick_theme_label"
                        android:textAppearance="@style/TextAppearance.Overdrive.Overline" />

                    <TextView
                        android:id="@+id/tvQuickThemeValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:text="@string/settings_theme_auto"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardLanguage"
                style="@style/Widget.Overdrive.Revamp.Card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/int_grid_gap_half"
                android:layout_weight="1"
                android:clickable="true"
                android:focusable="true"
                android:minHeight="@dimen/od_touch_primary">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/od_icon_md"
                        android:layout_height="@dimen/od_icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_language"
                        app:tint="?attr/colorPrimary" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_12"
                        android:text="@string/settings_quick_language_label"
                        android:textAppearance="@style/TextAppearance.Overdrive.Overline" />

                    <TextView
                        android:id="@+id/tvLanguageValue"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_2"
                        android:ellipsize="end"
                        android:maxLines="1"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                        android:textSize="16sp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_24"
            android:layout_marginBottom="@dimen/od_space_8"
            android:accessibilityHeading="true"
            android:text="@string/settings_overline_preferences"
            android:textAppearance="@style/TextAppearance.Overdrive.Overline" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSectionRecording"
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/od_space_12"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/od_touch_standard"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_recording_settings"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_16"
                    android:layout_marginEnd="@dimen/od_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_recording"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_2"
                        android:text="@string/settings_section_recording_subtitle"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSectionSurveillance"
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/od_space_12"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/od_touch_standard"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_sentry"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_16"
                    android:layout_marginEnd="@dimen/od_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_surveillance"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_2"
                        android:text="@string/settings_section_surveillance_subtitle"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSectionStorage"
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/od_space_12"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/od_touch_standard"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_recording_storage"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_16"
                    android:layout_marginEnd="@dimen/od_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/recording_lib_filter_section_storage"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_2"
                        android:text="@string/settings_section_storage_subtitle"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Status overlay: three inline switches. -->
        <com.google.android.material.card.MaterialCardView
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/od_icon_md"
                        android:layout_height="@dimen/od_icon_md"
                        android:contentDescription="@null"
                        android:src="@drawable/ic_overlay_rec_active"
                        app:tint="?attr/colorOnSurfaceVariant" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_16"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/settings_section_overlay"
                            android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                            android:textSize="16sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/od_space_2"
                            android:text="@string/settings_overlay_subtitle"
                            android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowOverlayCamera"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/od_space_8"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/od_touch_standard"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/od_space_12"
                        android:layout_weight="1"
                        android:text="@string/settings_overlay_camera_title"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swOverlayCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowOverlayTrip"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/od_touch_standard"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/od_space_12"
                        android:layout_weight="1"
                        android:text="@string/settings_overlay_trip_title"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swOverlayTrip"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rowOverlayRoadSense"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="0dp"
                    android:background="?attr/selectableItemBackground"
                    android:clickable="true"
                    android:focusable="true"
                    android:gravity="center_vertical"
                    android:minHeight="@dimen/od_touch_standard"
                    android:orientation="horizontal">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/od_space_12"
                        android:layout_weight="1"
                        android:text="@string/settings_overlay_roadsense_title"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle" />

                    <com.google.android.material.switchmaterial.SwitchMaterial
                        android:id="@+id/swOverlayRoadSense"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content" />
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Shared with the landscape overlay pane; carries its own 12dp top/bottom margins. -->
        <include layout="@layout/include_remote_communication_settings" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSectionAdb"
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/od_space_12"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/od_touch_standard"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_diagnostics"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_16"
                    android:layout_marginEnd="@dimen/od_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_adb"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_2"
                        android:text="@string/settings_adb_subtitle"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Security (PIN lock) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSectionSecurity"
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/od_space_12"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/od_touch_standard"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_security_lock"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_16"
                    android:layout_marginEnd="@dimen/od_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_security"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_2"
                        android:text="@string/settings_security_subtitle"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSectionDaemons"
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="0dp"
            android:clickable="true"
            android:focusable="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/od_touch_standard"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_services"
                    app:tint="?attr/colorOnSurfaceVariant" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_16"
                    android:layout_marginEnd="@dimen/od_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/daemons_hero_title"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_2"
                        android:text="@string/settings_section_daemons_subtitle"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_24"
            android:layout_marginBottom="@dimen/od_space_8"
            android:accessibilityHeading="true"
            android:text="@string/settings_overline_about_data"
            android:textAppearance="@style/TextAppearance.Overdrive.Overline" />

        <!-- Reset data: the only destructive action on this page. -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardResetData"
            style="@style/Widget.Overdrive.Revamp.Card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/od_space_16"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorErrorContainer">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:minHeight="@dimen/od_touch_standard"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_delete"
                    app:tint="?attr/colorOnErrorContainer" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/od_space_16"
                    android:layout_marginEnd="@dimen/od_space_12"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_action_reset_data"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowTitle"
                        android:textColor="?attr/colorOnErrorContainer"
                        android:textSize="16sp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/od_space_2"
                        android:text="@string/settings_reset_row_subtitle"
                        android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta"
                        android:textColor="?attr/colorOnErrorContainer" />
                </LinearLayout>

                <ImageView
                    android:layout_width="@dimen/od_icon_md"
                    android:layout_height="@dimen/od_icon_md"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnErrorContainer" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Service Mode -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/cardSectionServiceMode"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/page_padding_top"
            android:clickable="true"
            android:focusable="true"
            app:cardBackgroundColor="?attr/colorSurfaceContainer"
            app:cardCornerRadius="@dimen/card_radius_standard"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/card_padding_standard">

                <ImageView
                    android:layout_width="@dimen/card_icon_standard"
                    android:layout_height="@dimen/card_icon_standard"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_services"
                    app:tint="?attr/colorPrimary" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="16dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_section_service_mode"
                        android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                        android:textColor="?attr/colorOnSurface" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_section_service_mode_subtitle"
                        android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                        android:textColor="?attr/colorOnSurfaceVariant" />
                </LinearLayout>

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:contentDescription="@null"
                    android:src="@drawable/ic_chevron_right"
                    app:tint="?attr/colorOnSurfaceVariant" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/tvSettingsFooter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="@style/TextAppearance.Overdrive.Settings.RowMeta" />
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
