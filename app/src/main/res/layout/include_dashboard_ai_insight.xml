<?xml version="1.0" encoding="utf-8"?>
<!-- Two-line preview; tapping the card expands the text and shows the meta line. -->
<com.google.android.material.card.MaterialCardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/aiInsightCard"
    android:foreground="?attr/selectableItemBackground"
    style="@style/Widget.Overdrive.Revamp.Card"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/od_space_12"
    android:clickable="true"
    android:contentDescription="@string/dashboard_ai_insight_open"
    android:focusable="true"
    android:visibility="gone">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/aiInsightIconSurface"
                        android:layout_width="@dimen/od_icon_sm"
                        android:layout_height="@dimen/od_icon_sm"
                        app:cardBackgroundColor="@android:color/transparent"
                        app:cardCornerRadius="0dp"
                        app:cardElevation="0dp"
                        app:strokeWidth="0dp">

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:contentDescription="@null"
                            android:src="@drawable/ic_smart_toy"
                            app:tint="?attr/colorPrimary" />
                    </com.google.android.material.card.MaterialCardView>

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/od_space_8"
                        android:layout_weight="1"
                        android:text="@string/dashboard_ai_insight_kicker"
                        android:textAppearance="@style/TextAppearance.Overdrive.Overline"
                        android:textColor="?attr/colorPrimary" />
                </LinearLayout>

                <TextView
                    android:id="@+id/aiInsightTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/od_space_6"
                    android:text="@string/dashboard_ai_insight_default_title"
                    android:textAppearance="@style/TextAppearance.Overdrive.CardTitle" />
            </LinearLayout>

            <ImageView
                android:id="@+id/aiInsightExpand"
                android:layout_width="@dimen/od_icon_md"
                android:layout_height="@dimen/od_icon_md"
                android:layout_marginStart="@dimen/od_space_12"
                android:contentDescription="@null"
                android:src="@drawable/ic_expand"
                app:tint="?attr/colorOnSurfaceVariant" />
        </LinearLayout>

        <TextView
            android:id="@+id/aiInsightText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/od_space_4"
            android:breakStrategy="balanced"
            android:ellipsize="end"
            android:lineHeight="19sp"
            android:maxLines="2"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="13.5sp" />

        <TextView
            android:id="@+id/aiInsightMeta"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:textAppearance="@style/TextAppearance.Overdrive.Dashboard.Meta"
            android:visibility="gone" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
