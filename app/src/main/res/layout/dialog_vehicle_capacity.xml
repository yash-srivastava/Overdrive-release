<?xml version="1.0" encoding="utf-8"?>
<!--
  Vehicle capacity / model picker dialog.

  Two surfaces:
    - Summary block (read-only): current capacity, SOH, effective kWh, model,
      last calibration.
    - Editable controls: M3 outlined capacity input + M3 ExposedDropdownMenu
      for model selection. The dropdown expands like a Material menu, not a
      legacy Spinner.
-->
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fillViewport="false">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <!-- What the daemon currently holds. Recessed into its own panel so the
             read-only half is separated from the editable half by a surface
             rather than by a hairline.

             Capacity, SOH and model always end up populated, so they hold a
             placeholder until the fetch lands rather than appearing into a
             dialog the user is already looking at. The derived two are
             genuinely conditional and stay GONE without data. -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/dialog_inset_panel"
            android:orientation="vertical"
            android:padding="@dimen/dashboard_modern_card_padding">

            <TextView
                android:id="@+id/vehicleSummaryCapacity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/vehicleSummarySoh"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/vehicleSummaryModel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="?attr/colorOnSurface" />

            <!-- Derived readings. Smaller and dimmer than the three above: they
                 report what the daemon worked out, not what is set. -->
            <TextView
                android:id="@+id/vehicleSummaryEffective"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />

            <TextView
                android:id="@+id/vehicleSummaryCalibration"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textAppearance="@style/TextAppearance.Material3.BodySmall"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:visibility="gone" />
        </LinearLayout>

        <!-- Model dropdown — M3 ExposedDropdownMenu. The MaterialAutoCompleteTextView
             is non-editable so users tap the field and pick from the menu rather
             than typing. -->
        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/vehicleModelLayout"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:hint="@string/vehicle_dialog_model_label">

            <com.google.android.material.textfield.MaterialAutoCompleteTextView
                android:id="@+id/vehicleModelDropdown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="none"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
        </com.google.android.material.textfield.TextInputLayout>

        <!-- Capacity input — M3 outlined text field with kWh suffix. -->
        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:hint="@string/vehicle_dialog_capacity_label"
            app:helperText="@string/vehicle_dialog_capacity_helper"
            app:helperTextEnabled="true"
            app:suffixText="@string/vehicle_dialog_capacity_suffix">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/vehicleCapacityInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionDone"
                android:inputType="numberDecimal"
                android:maxLines="1"
                android:textAppearance="@style/TextAppearance.Material3.BodyLarge" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
