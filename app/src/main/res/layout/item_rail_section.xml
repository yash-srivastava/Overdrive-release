<?xml version="1.0" encoding="utf-8"?>
<!--
  Rail category header, non-interactive. MainActivity cross-fades the overline label (wide rail)
  with the hairline (compact rail); the fixed height keeps the swap free of relayout.
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="@dimen/shell_rail_section_height">

    <View
        android:id="@+id/railSectionRule"
        android:layout_width="@dimen/shell_rail_section_rule_width"
        android:layout_height="@dimen/od_hairline"
        android:layout_gravity="start|center_vertical"
        android:layout_marginStart="@dimen/shell_rail_content_inset"
        android:background="?attr/colorOutlineVariant" />

    <TextView
        android:id="@+id/railSectionLabel"
        android:accessibilityHeading="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:alpha="0"
        android:ellipsize="end"
        android:maxLines="1"
        android:paddingStart="@dimen/shell_rail_content_inset"
        android:paddingEnd="@dimen/shell_rail_plate_inset_h"
        android:paddingBottom="@dimen/shell_rail_section_label_bottom"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.Overdrive.Overline"
        android:visibility="invisible" />
</FrameLayout>
