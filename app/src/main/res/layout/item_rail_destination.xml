<?xml version="1.0" encoding="utf-8"?>
<!--
  Rail row; the whole row is the button. The icon sits 40dp from the rail's leading edge at every
  rail width. MainActivity shows the label only while the rail is wider than compact.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rail_item_indicator"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="@dimen/shell_rail_row_height"
    android:orientation="horizontal"
    android:paddingStart="@dimen/shell_rail_content_inset"
    android:paddingEnd="@dimen/shell_rail_content_inset">

    <ImageView
        android:id="@+id/railItemIcon"
        android:layout_width="@dimen/od_icon_md"
        android:layout_height="@dimen/od_icon_md"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        app:tint="@color/rail_item_icon_tint" />

    <TextView
        android:id="@+id/railItemLabel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/shell_rail_label_gap"
        android:layout_weight="1"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:maxLines="1"
        android:textAlignment="viewStart"
        android:textAppearance="@style/TextAppearance.Overdrive.Shell.RailLabel"
        android:textColor="@color/rail_item_label_tint"
        android:visibility="gone" />
</LinearLayout>
