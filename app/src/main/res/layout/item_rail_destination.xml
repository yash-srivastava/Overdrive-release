<?xml version="1.0" encoding="utf-8"?>
<!--
  Single rail row — destinations plus the Language / Guided tour actions that
  landscape parks at the bottom. MainActivity.applyRailRowLayout flips between
  the compact (icon over label) and expanded (icon beside label) forms, and the
  rail driver tags this view with the destination id.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rail_item_indicator"
    android:clickable="true"
    android:focusable="true"
    android:gravity="center"
    android:minHeight="56dp"
    android:orientation="vertical"
    android:paddingVertical="6dp">

    <ImageView
        android:id="@+id/railItemIcon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_gravity="center"
        android:contentDescription="@null"
        android:duplicateParentState="true"
        app:tint="@color/rail_item_icon_tint" />

    <TextView
        android:id="@+id/railItemLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:duplicateParentState="true"
        android:ellipsize="end"
        android:gravity="center_horizontal"
        android:maxLines="1"
        android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
        android:textColor="@color/rail_item_label_tint"
        android:visibility="gone" />
</LinearLayout>
