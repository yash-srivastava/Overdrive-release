<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Trip Briefing: the car-start "Heading to work? Want directions?" prompt. The spoken line is
         greeting + heading + duration (or one extra that replaces it) + question, joined by spaces,
         and read aloud by text-to-speech. -->
    <string name="trip_briefing_greeting_morning">早上好。</string>
    <string name="trip_briefing_greeting_afternoon">下午好。</string>
    <string name="trip_briefing_greeting_evening">晚上好。</string>
    <string name="trip_briefing_heading_home">要回家吗？</string>
    <string name="trip_briefing_heading_work">要去公司吗？</string>
    <!-- %1$s: the place's name, e.g. "Phoenix Mall". -->
    <string name="trip_briefing_heading_place">要去%1$s吗？</string>
    <plurals name="trip_briefing_duration">
        <item quantity="other">大约%1$d分钟。</item>
    </plurals>
    <!-- %1$s: range left, %2$s: the trip's length, each "31 km" or "19 mi". -->
    <string name="trip_briefing_extra_range">续航紧张：剩余%1$s，本次行程%2$s。</string>
    <plurals name="trip_briefing_extra_hazards">
        <item quantity="other">沿途有%1$d处新的危险路况。</item>
    </plurals>
    <!-- %1$s: an hour of the day in the device's clock format, e.g. "7 PM" or "19:00". -->
    <string name="trip_briefing_extra_rain">%1$s左右可能下雨。</string>
    <string name="trip_briefing_question">需要导航吗？</string>
    <string name="trip_briefing_distance_km">%1$d公里</string>
    <string name="trip_briefing_distance_mi">%1$d英里</string>

    <!-- The destination as the AI assistant should say it. -->
    <string name="trip_briefing_said_home">家</string>
    <string name="trip_briefing_said_work">公司</string>

    <!-- Card -->
    <string name="trip_briefing_title_home">家</string>
    <string name="trip_briefing_title_work">公司</string>
    <!-- Title for a regular destination that has no name yet. -->
    <string name="trip_briefing_title_unnamed">常去的地点</string>
    <string name="trip_briefing_name_place">命名地点</string>
    <string name="trip_briefing_no">不用</string>
    <string name="trip_briefing_go_failed">未能开始导航。请打开地图进行导航。</string>
    <!-- The car's own navigation app. -->
    <string name="trip_briefing_app_car">车机导航</string>
</resources>
