<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Trip Briefing: the car-start "Heading to work? Want directions?" prompt. The spoken line is
         greeting + heading + duration (or one extra that replaces it) + question, joined by spaces,
         and read aloud by text-to-speech. -->
    <string name="trip_briefing_greeting_morning">Günaydın.</string>
    <string name="trip_briefing_greeting_afternoon">İyi günler.</string>
    <string name="trip_briefing_greeting_evening">İyi akşamlar.</string>
    <string name="trip_briefing_heading_home">Eve mi gidiyorsunuz?</string>
    <string name="trip_briefing_heading_work">İşe mi gidiyorsunuz?</string>
    <!-- %1$s: the place's name, e.g. "Phoenix Mall". -->
    <string name="trip_briefing_heading_place">%1$s konumuna mı gidiyorsunuz?</string>
    <plurals name="trip_briefing_duration">
        <item quantity="one">Yaklaşık %1$d dakika.</item>
        <item quantity="other">Yaklaşık %1$d dakika.</item>
    </plurals>
    <!-- %1$s: range left, %2$s: the trip's length, each "31 km" or "19 mi". -->
    <string name="trip_briefing_extra_range">Menzil sınırda: %2$s yol için %1$s kaldı.</string>
    <plurals name="trip_briefing_extra_hazards">
        <item quantity="one">Yolda %1$d yeni tehlike var.</item>
        <item quantity="other">Yolda %1$d yeni tehlike var.</item>
    </plurals>
    <!-- %1$s: an hour of the day in the device's clock format, e.g. "7 PM" or "19:00". -->
    <string name="trip_briefing_extra_rain">Saat %1$s civarında yağmur bekleniyor.</string>
    <string name="trip_briefing_question">Yol tarifi ister misiniz?</string>
    <string name="trip_briefing_distance_km">%1$d km</string>
    <string name="trip_briefing_distance_mi">%1$d mi</string>

    <!-- The destination as the AI assistant should say it. -->
    <string name="trip_briefing_said_home">ev</string>
    <string name="trip_briefing_said_work">iş</string>

    <!-- Card -->
    <string name="trip_briefing_title_home">Ev</string>
    <string name="trip_briefing_title_work">İş</string>
    <!-- Title for a regular destination that has no name yet. -->
    <string name="trip_briefing_title_unnamed">Her zamanki durağınız</string>
    <string name="trip_briefing_name_place">Yeri adlandır</string>
    <string name="trip_briefing_no">Hayır</string>
    <string name="trip_briefing_go_failed">Yol tarifi başlamadı. Gezinmek için haritayı açın.</string>
    <!-- The car's own navigation app. -->
    <string name="trip_briefing_app_car">Araç navigasyonu</string>
</resources>
