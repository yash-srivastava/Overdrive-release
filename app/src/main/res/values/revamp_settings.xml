<?xml version="1.0" encoding="utf-8"?>
<!-- Integrations + Settings page tokens. Shared tokens live in revamp_tokens.xml. -->
<resources>
    <!-- Integrations -->
    <dimen name="int_grid_gap_half">6dp</dimen>
    <dimen name="int_icon_glyph">26dp</dimen>
    <dimen name="int_pill_height">24dp</dimen>
    <dimen name="int_pill_padding_h">8dp</dimen>
    <dimen name="int_header_min_height">40dp</dimen>

    <!-- Settings -->
    <dimen name="set_subrail_width">236dp</dimen>
    <dimen name="set_subrail_row_height">52dp</dimen>
    <dimen name="set_subrail_row_padding_start">14dp</dimen>
    <dimen name="set_subrail_row_padding_end">10dp</dimen>
    <dimen name="set_theme_gap_half">5dp</dimen>
    <dimen name="set_theme_preview_height">58dp</dimen>
    <dimen name="set_row_link_min_height">60dp</dimen>
    <dimen name="set_nav_column_gap">16dp</dimen>
    <dimen name="set_nav_icon">20dp</dimen>

    <style name="TextAppearance.Overdrive.Integrations.Pill" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textAllCaps">true</item>
    </style>
    <style name="TextAppearance.Overdrive.Integrations.CardTitle" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">20sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Overdrive.Settings.RowTitle" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textSize">15sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>
    <style name="TextAppearance.Overdrive.Settings.RowMeta" parent="TextAppearance.Material3.BodySmall">
        <item name="android:textSize">13sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>
    <style name="TextAppearance.Overdrive.Settings.Lede" parent="TextAppearance.Material3.BodyMedium">
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Visual only: the whole integration card is the touch target. -->
    <style name="Widget.Overdrive.Integrations.Configure" parent="Widget.Material3.Button.TonalButton">
        <item name="cornerRadius">@dimen/od_radius_pill_44</item>
        <item name="android:minHeight">44dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingLeft">16dp</item>
        <item name="android:paddingRight">16dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textAppearance">@style/TextAppearance.Material3.LabelLarge</item>
    </style>
    <!-- Pin grid columns follow the window width, not the orientation. -->
    <integer name="set_nav_columns">1</integer>
</resources>
