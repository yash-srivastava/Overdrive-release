<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Trip Briefing: the car-start "Heading to work? Want directions?" prompt. The spoken line is
         greeting + heading + duration (or one extra that replaces it) + question, joined by spaces,
         and read aloud by text-to-speech. -->
    <string name="trip_briefing_greeting_morning">Bom dia.</string>
    <string name="trip_briefing_greeting_afternoon">Boa tarde.</string>
    <string name="trip_briefing_greeting_evening">Boa noite.</string>
    <string name="trip_briefing_heading_home">Indo para casa?</string>
    <string name="trip_briefing_heading_work">Indo para o trabalho?</string>
    <!-- %1$s: the place's name, e.g. "Phoenix Mall". -->
    <string name="trip_briefing_heading_place">Indo para %1$s?</string>
    <plurals name="trip_briefing_duration">
        <item quantity="one">Cerca de %1$d minuto.</item>
        <item quantity="other">Cerca de %1$d minutos.</item>
    </plurals>
    <!-- %1$s: range left, %2$s: the trip's length, each "31 km" or "19 mi". -->
    <string name="trip_briefing_extra_range">Autonomia apertada: restam %1$s para uma viagem de %2$s.</string>
    <plurals name="trip_briefing_extra_hazards">
        <item quantity="one">%1$d novo perigo no caminho.</item>
        <item quantity="other">%1$d novos perigos no caminho.</item>
    </plurals>
    <!-- %1$s: an hour of the day in the device's clock format, e.g. "7 PM" or "19:00". -->
    <string name="trip_briefing_extra_rain">Deve chover por volta das %1$s.</string>
    <string name="trip_briefing_question">Quer que eu trace a rota?</string>
    <string name="trip_briefing_distance_km">%1$d km</string>
    <string name="trip_briefing_distance_mi">%1$d mi</string>

    <!-- The destination as the AI assistant should say it. -->
    <string name="trip_briefing_said_home">casa</string>
    <string name="trip_briefing_said_work">trabalho</string>

    <!-- Card -->
    <string name="trip_briefing_title_home">Casa</string>
    <string name="trip_briefing_title_work">Trabalho</string>
    <!-- Title for a regular destination that has no name yet. -->
    <string name="trip_briefing_title_unnamed">Seu destino de sempre</string>
    <string name="trip_briefing_name_place">Nomear local</string>
    <string name="trip_briefing_no">Não</string>
    <string name="trip_briefing_go_failed">As instruções não foram iniciadas. Abra o mapa para navegar.</string>
    <!-- The car's own navigation app. -->
    <string name="trip_briefing_app_car">GPS do carro</string>
</resources>
