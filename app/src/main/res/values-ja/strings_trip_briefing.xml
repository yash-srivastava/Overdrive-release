<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Trip Briefing: the car-start "Heading to work? Want directions?" prompt. The spoken line is
         greeting + heading + duration (or one extra that replaces it) + question, joined by spaces,
         and read aloud by text-to-speech. -->
    <string name="trip_briefing_greeting_morning">おはようございます。</string>
    <string name="trip_briefing_greeting_afternoon">こんにちは。</string>
    <string name="trip_briefing_greeting_evening">こんばんは。</string>
    <string name="trip_briefing_heading_home">ご自宅に向かいますか？</string>
    <string name="trip_briefing_heading_work">職場に向かいますか？</string>
    <!-- %1$s: the place's name, e.g. "Phoenix Mall". -->
    <string name="trip_briefing_heading_place">%1$sに向かいますか？</string>
    <plurals name="trip_briefing_duration">
        <item quantity="other">約%1$d分です。</item>
    </plurals>
    <!-- %1$s: range left, %2$s: the trip's length, each "31 km" or "19 mi". -->
    <string name="trip_briefing_extra_range">航続距離がぎりぎりです。残り%1$s、目的地まで%2$s。</string>
    <plurals name="trip_briefing_extra_hazards">
        <item quantity="other">ルート上に新しい危険箇所が%1$d件あります。</item>
    </plurals>
    <!-- %1$s: an hour of the day in the device's clock format, e.g. "7 PM" or "19:00". -->
    <string name="trip_briefing_extra_rain">%1$sごろに雨が降りそうです。</string>
    <string name="trip_briefing_question">ルート案内を開始しますか？</string>
    <string name="trip_briefing_distance_km">%1$d km</string>
    <string name="trip_briefing_distance_mi">%1$d マイル</string>

    <!-- The destination as the AI assistant should say it. -->
    <string name="trip_briefing_said_home">自宅</string>
    <string name="trip_briefing_said_work">職場</string>

    <!-- Card -->
    <string name="trip_briefing_title_home">ホーム</string>
    <string name="trip_briefing_title_work">仕事</string>
    <!-- Title for a regular destination that has no name yet. -->
    <string name="trip_briefing_title_unnamed">いつもの立ち寄り先</string>
    <string name="trip_briefing_name_place">名前を付ける</string>
    <string name="trip_briefing_no">いいえ</string>
    <string name="trip_briefing_go_failed">案内を開始できませんでした。地図を開いて案内を始めてください。</string>
    <!-- The car's own navigation app. -->
    <string name="trip_briefing_app_car">車載ナビ</string>
</resources>
