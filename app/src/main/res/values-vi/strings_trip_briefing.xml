<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Trip Briefing: the car-start "Heading to work? Want directions?" prompt. The spoken line is
         greeting + heading + duration (or one extra that replaces it) + question, joined by spaces,
         and read aloud by text-to-speech. -->
    <string name="trip_briefing_greeting_morning">Chào buổi sáng.</string>
    <string name="trip_briefing_greeting_afternoon">Chào buổi chiều.</string>
    <string name="trip_briefing_greeting_evening">Chào buổi tối.</string>
    <string name="trip_briefing_heading_home">Bạn đang về nhà à?</string>
    <string name="trip_briefing_heading_work">Bạn đang đi làm à?</string>
    <!-- %1$s: the place's name, e.g. "Phoenix Mall". -->
    <string name="trip_briefing_heading_place">Bạn đang đến %1$s à?</string>
    <plurals name="trip_briefing_duration">
        <item quantity="other">Khoảng %1$d phút.</item>
    </plurals>
    <!-- %1$s: range left, %2$s: the trip's length, each "31 km" or "19 mi". -->
    <string name="trip_briefing_extra_range">Tầm hoạt động hơi sát: còn %1$s cho chuyến đi %2$s.</string>
    <plurals name="trip_briefing_extra_hazards">
        <item quantity="other">Có %1$d mối nguy mới trên đường.</item>
    </plurals>
    <!-- %1$s: an hour of the day in the device's clock format, e.g. "7 PM" or "19:00". -->
    <string name="trip_briefing_extra_rain">Có thể mưa vào khoảng %1$s.</string>
    <string name="trip_briefing_question">Bạn có muốn chỉ đường không?</string>
    <string name="trip_briefing_distance_km">%1$d km</string>
    <string name="trip_briefing_distance_mi">%1$d dặm</string>

    <!-- The destination as the AI assistant should say it. -->
    <string name="trip_briefing_said_home">nhà</string>
    <string name="trip_briefing_said_work">cơ quan</string>

    <!-- Card -->
    <string name="trip_briefing_title_home">Nhà</string>
    <string name="trip_briefing_title_work">Cơ quan</string>
    <!-- Title for a regular destination that has no name yet. -->
    <string name="trip_briefing_title_unnamed">Điểm dừng quen thuộc</string>
    <string name="trip_briefing_name_place">Đặt tên</string>
    <string name="trip_briefing_no">Không</string>
    <string name="trip_briefing_go_failed">Chưa bắt đầu chỉ đường. Mở bản đồ để dẫn đường.</string>
    <!-- The car's own navigation app. -->
    <string name="trip_briefing_app_car">Dẫn đường trên xe</string>
</resources>
