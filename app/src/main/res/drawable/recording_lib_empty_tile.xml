<?xml version="1.0" encoding="utf-8"?>
<!-- Tile behind an empty-state icon. surfaceContainerHigh with an
     outlineVariant hairline, matching dashboard_metric_box. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHigh" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    <corners android:radius="@dimen/card_radius_standard" />
</shape>
