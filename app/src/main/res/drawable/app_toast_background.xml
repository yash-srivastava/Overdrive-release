<?xml version="1.0" encoding="utf-8"?>
<!-- In-page toast chip. Matches the WebView .toast surface. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHighest" />
    <stroke
        android:width="1dp"
        android:color="?attr/colorOutlineVariant" />
    <corners android:radius="@dimen/dashboard_modern_radius" />
</shape>
