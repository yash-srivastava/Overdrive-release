<?xml version="1.0" encoding="utf-8"?>
<!-- Small glass chip over video (object, source, gap hint). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rec_player_quad_selected">
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="16dp" />
            <solid android:color="@color/rec_player_glass" />
            <stroke
                android:width="1dp"
                android:color="@color/rec_player_glass_stroke" />
        </shape>
    </item>
</ripple>
