<?xml version="1.0" encoding="utf-8"?>
<!-- 32dp translucent round button inside a 48dp hit area (player chrome). -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/rec_player_quad_selected">
    <item>
        <inset android:inset="8dp">
            <shape android:shape="oval">
                <solid android:color="@color/rec_player_glass" />
                <stroke
                    android:width="1dp"
                    android:color="@color/rec_player_glass_stroke" />
            </shape>
        </inset>
    </item>
</ripple>
