<?xml version="1.0" encoding="utf-8"?>
<!--
  Read-only panel nested inside a dialog. surfaceContainerHighest sits one tier
  above the surfaceContainerHigh that Theme.Overdrive.M3.Dialog gives the window,
  so the panel lifts off the dialog.
-->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="?attr/colorSurfaceContainerHighest" />
    <corners android:radius="@dimen/dashboard_modern_radius" />
</shape>
