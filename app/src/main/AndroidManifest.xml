    <!-- Exact-alarm permissions for API 31+ (Android 12+). Without these,
         ProcessRevivalReceiver's setExactAndAllowWhileIdle throws
         SecurityException and silently downgrades to setAndAllowWhileIdle —
         which still fires during doze but only at the ~9-min maintenance
         window cadence. With these declared, the 8-min/12-min revival
         alarms fire on time. SCHEDULE_EXACT_ALARM is the API-31 form
         (user-grantable); USE_EXACT_ALARM is the API-33 form (auto-granted
         for apps that legitimately need exact alarms — alarm clocks,
         calendar reminders, vehicle-monitoring daemons like ours). -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
