    <application
        android:name="com.overdrive.app.OverdriveApplication"
        android:allowBackup="false"
        android:label="@string/app_name"
        android:extractNativeLibs="true"
        android:theme="@style/Theme.Overdrive.M3"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:persistent="true"
        android:requestLegacyExternalStorage="true"
        android:supportsRtl="true"
        android:usesCleartextTraffic="true">

        <!-- New Modern UI Activity -->
        <activity 
            android:name="com.overdrive.app.ui.MainActivity"
            android:exported="true"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden"
            android:launchMode="singleTop">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="com.overdrive.app.START_LOCATION_ACTIVITY" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>



        <!-- PIN Lock Activity. Gates MainActivity only — never the cam
             daemon, AccSentry, surveillance, recording, Telegram alerts,
             the status overlay service, the Blocker, or the Deterrent.
             In MainActivity's task (singleTop) so unlock returns straight
             to the user's nav destination. excludeFromRecents keeps the
             keypad off the recents stack. -->
        <!--
            configChanges is deliberately MINIMAL (keyboardHidden only) — do NOT
            add orientation|screenSize here. PinLockActivity has a distinct
            layout-land/activity_pin_lock.xml (horizontal two-column keypad) and
            inflates its layout only in onCreate with no onConfigurationChanged
            override, so it MUST recreate on rotation to pick up the landscape
            layout on the rotatable BYD Seal panel. Handling the config change
            in-place would strand the portrait layout in landscape. The ACC-ON
            self-minimize receiver is registered in onCreate / unregistered in
            onDestroy, so recreation re-arms it cleanly; the only cost is a
            sub-millisecond window during destroy->create where an ACC_ON
            broadcast could be missed (bounded, no security impact — the PIN
            gate stays armed).
        -->
        <activity
            android:name="com.overdrive.app.ui.PinLockActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:excludeFromRecents="true"
            android:screenOrientation="unspecified"
            android:configChanges="keyboardHidden"
            android:theme="@style/Theme.Overdrive.M3" />

        <!-- RoadSense hazard map — native GPU MapLibre Activity. Launched from the
             RoadSense web tab via the AndroidBridge.openHazardMap() JS bridge. Not
             a WebView page: MapLibre GL needs WebGL2/modern Chrome the head-unit
             WebView lacks. configChanges keeps the GL surface alive across rotation. -->
        <activity
            android:name="com.overdrive.app.navmap.RoadSenseMapActivity"
            android:exported="false"
            android:launchMode="singleTop"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.Overdrive.M3" />

        <!-- View-only cluster mirror of the map. A distinct component with its OWN
             taskAffinity + singleInstance so it lives in a SEPARATE OS task on the
             cluster display and can coexist with the interactive infotainment
             instance (display 0) without either stealing the other, independent
             of NEW_TASK/MULTIPLE_TASK flag semantics. Launched by ClusterMapProjector
             onto the cluster display via am start. The cluster is non-touch; the
             Activity reads its launching component (alias) to enter clusterMode and
             strip all touch chrome. -->
        <!-- View-only cluster mirror — a REAL Activity subclass (NOT an alias):
             activity-alias IGNORES launchMode + taskAffinity (only valid on
             activity), so as an alias it inherited the target's singleTop + default
             affinity and shared a task with the infotainment instance (the two then
             couldn't coexist — opening the infotainment map resurfaced the cluster
             one). As a distinct activity with singleInstance + its own taskAffinity,
             it lives in a SEPARATE task on the cluster display, independent of the
             infotainment RoadSenseMapActivity.
             exported=true is REQUIRED: the daemon (shell uid 2000) launches it via
             `am start` onto the cluster; AMS rejects a non-exported component from a
             foreign uid. Safe: no sensitive input, only mirrors the nav route. -->
        <activity
            android:name="com.overdrive.app.navmap.RoadSenseClusterMapActivity"
            android:exported="true"
            android:taskAffinity="com.overdrive.app.cluster"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode|density|fontScale"
            android:theme="@style/Theme.Overdrive.M3" />

        <!-- Blocker Activity for Sentry Mode (transparent click blocker).
             exported=false: this activity has NO launch site anywhere in the
             app, but while exported it could be started externally
             (`am start -n com.overdrive.app/.BlockerActivity`). Its
             killBacklight() writes screen_brightness=0 and its restore path
             writes back a hardcoded 128 default — which would fight the dilink4
             stealth panel in both directions (capturing our 0 as "the user's
             brightness", or overwriting it). Nothing in-app regresses from
             closing it off; the panel-darkening job it was written for is now
             owned by com.overdrive.app.power.StealthPanel. -->
        <activity
            android:name="com.overdrive.app.BlockerActivity"
            android:exported="false"
            android:theme="@android:style/Theme.Translucent.NoTitleBar.Fullscreen"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|keyboardHidden" />

        <!-- Screen Deterrent: fullscreen warning shown on motion while ACC off.
             Launched via `am start` from byd_cam_daemon (UID 2000) AFTER the
             daemon wakes the panel via PowerManager.TurnBacklightOn. Uses
             singleInstance so repeat launches during sustained motion are
             coalesced (Activity already running just bumps onNewIntent / stays
             up while the deadline keeps extending). -->
        <activity
            android:name="com.overdrive.app.DeterrentActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:excludeFromRecents="true"
            android:launchMode="singleInstance"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation|fontScale|locale|layoutDirection|uiMode|density"
            android:showOnLockScreen="true"
            android:turnScreenOn="true" />

        <!-- Video Playback Activity - fullscreen player for the "Play Video"
             automation/keymap action. exported=true is REQUIRED: the CameraDaemon
             (shell uid 2000) launches it via `am start -n com.overdrive.app/.ui.VideoPlaybackActivity`
             (same bridge as DeterrentActivity) — the daemon can't render video itself.
             singleTask so a repeat play is delivered to the SAME instance via onNewIntent,
             which swaps the clip in place (setVideoURI releases the old player and resets
             its first-frame state). The launch passes NO activity-flag options: NEW_TASK is
             added by am itself, and the clear-task option would destroy the instance and
             defeat onNewIntent. Library clips stream from the daemon's raw endpoint. -->
        <activity
            android:name="com.overdrive.app.ui.VideoPlaybackActivity"
            android:exported="true"
            android:theme="@android:style/Theme.NoTitleBar.Fullscreen"
            android:excludeFromRecents="true"
            android:launchMode="singleTask"
            android:taskAffinity="com.overdrive.app.mediaplayer"
            android:screenOrientation="unspecified"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|navigation|fontScale|locale|layoutDirection|uiMode|density" />

        <!-- App Launcher Ghost Activity - Transparent, no-content anchor for the
             split-screen re-dock path. exported=true is REQUIRED: the CameraDaemon
             (shell uid 2000) launches it in windowing mode 3 (SPLIT_SCREEN_PRIMARY)
             via `am start` targeting
             com.overdrive.app/com.overdrive.app.launcher.AppLauncherGhostActivity
             to force a split-screen-primary stack, then moves an already-running app's
             task into it. singleInstance keeps the docked half a distinct task;
             excludeFromRecents so the invisible anchor never shows in Recents. It
             self-finishes after a short grace window (see AppLauncherGhostActivity). -->
        <activity
            android:name="com.overdrive.app.launcher.AppLauncherGhostActivity"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:resizeableActivity="true"
            android:launchMode="singleInstance"
            android:excludeFromRecents="true"
            android:exported="true" />

        <!-- Location Starter Activity - Transparent, starts Location service and finishes immediately -->
        <!-- Used by SentryDaemon to restart Location service without bringing app to foreground -->
        <activity
            android:name="com.overdrive.app.ui.LocationStarterActivity"
            android:exported="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:taskAffinity=""
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="com.overdrive.app.START_LOCATION_SILENT" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <receiver
            android:name="com.overdrive.app.receiver.BootReceiver"
            android:enabled="true"
            android:exported="true"
            android:directBootAware="true">
            <intent-filter android:priority="1000">
                <!-- Standard boot -->
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
                <action android:name="com.htc.intent.action.QUICKBOOT_POWERON" />
                <action android:name="android.intent.action.LOCKED_BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
                <!-- Screen/power events for ACC mode wake -->
                <action android:name="android.intent.action.SCREEN_ON" />
                <action android:name="android.intent.action.USER_PRESENT" />
                <action android:name="android.intent.action.USER_UNLOCKED" />
                <!-- Power connection events -->
                <action android:name="android.intent.action.ACTION_POWER_CONNECTED" />
                <action android:name="android.intent.action.ACTION_POWER_DISCONNECTED" />
                <!-- BYD-specific ACC mode events -->
                <action android:name="com.byd.action.ACC_ON" />
                <action android:name="com.byd.action.ACC_OFF" />
                <action android:name="com.byd.action.IGN_ON" />
                <action android:name="com.byd.accmode.ACC_MODE_CHANGED" />
                <!-- Network state changes (WiFi reconnect) -->
                <action android:name="android.net.wifi.STATE_CHANGE" />
                <action android:name="android.net.conn.CONNECTIVITY_CHANGE" />
            </intent-filter>
        </receiver>

        <!-- Process Revival Receiver - AlarmManager-driven watchdog that revives
             the process if it has been killed (force-stop, OOM, OEM cleanup).
             No intent-filter: only invoked via explicit PendingIntent. -->
        <receiver
            android:name="com.overdrive.app.receiver.ProcessRevivalReceiver"
            android:enabled="true"
            android:exported="false"
            android:directBootAware="true" />

        <!-- Location Boot Receiver - Auto-start Location service after device reboot -->
        <receiver
            android:name="com.overdrive.app.receiver.LocationBootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>


        <!-- Location Sidecar Service - Writes GPS to shared file for daemon -->
        <service
            android:name="com.overdrive.app.services.LocationSidecarService"
            android:foregroundServiceType="location|dataSync"
            android:exported="true" />

        <!-- Daemon Keepalive Service - Keeps app alive and monitors SCREEN_OFF.
             exported=true is REQUIRED: the CameraDaemon (shell uid 2000) respawns
             the app headlessly via `am start-foreground-service -n
             com.overdrive.app/.services.DaemonKeepaliveService` in
             KeymapApiHandler.forceRestartAppForA11y() (the a11y-bind-wedge
             recovery). AMS rejects a non-exported component launched from a
             foreign uid, so exported=false would let the watchdog force-stop the
             app but silently fail to respawn it — the same constraint
             LocationSidecarService / RoadSenseImuSidecarService document above.
             The service self-guards in onStartCommand (post-update defer +
             permission checks), so exporting it carries the same low risk. -->
        <service
            android:name="com.overdrive.app.services.DaemonKeepaliveService"
            android:foregroundServiceType="specialUse|dataSync"
            android:exported="true" />

        <!-- RoadSense IMU Sidecar - the ONLY app-side RoadSense component (D-023).
             Acquires -iner accel+gyro at ~100 Hz and batches them to the daemon
             IPC (port 19877) as IMU_BATCH frames. Daemon owns its lifecycle and
             drives rate via the EXTRA_RATE hint (D-021). Started by the daemon,
             not exported. -->
        <!-- exported=true so the CameraDaemon (shell uid, synthetic context, can't
             startForegroundService cross-process) can launch it via
             `am start-foreground-service` — the same proven path GpsMonitor uses for
             LocationSidecarService. -->
        <service
            android:name="com.overdrive.app.roadsense.sidecar.RoadSenseImuSidecarService"
            android:foregroundServiceType="dataSync"
            android:exported="true" />

        <!-- RoadSense floating overlay (app-side renderer, D-024). Reads
             daemon-published roadSense.overlayState from UCM and draws the
             pill/card. specialUse FGS like StatusOverlayService.
             exported=true so the shell-uid CameraDaemon can launch it via `am`
             on ACC-on + feature-on (startFromDaemon), the same cross-process path
             RoadSenseImuSidecarService uses — otherwise the overlay only appears
             after the user opens MainActivity. The service self-guards the overlay
             permission in onStartCommand, so an am launch without it cleanly no-ops. -->
        <service
            android:name="com.overdrive.app.roadsense.overlay.RoadSenseOverlayService"
            android:foregroundServiceType="specialUse|dataSync"
            android:exported="true" />


        <!-- Status Overlay Service - Floating recording/trip status indicator -->
        <service
            android:name="com.overdrive.app.overlay.StatusOverlayService"
            android:foregroundServiceType="specialUse"
            android:exported="false" />

        <!-- Media Playback Service - plays the "Play Audio" automation/keymap sound
             in the REAL app process. exported=true is REQUIRED: the CameraDaemon
             (shell uid 2000, synthetic context) launches it via
             `am start-foreground-service -n com.overdrive.app/.services.MediaPlaybackService`
             — the daemon CANNOT play a MediaPlayer itself (prepare() fails 0x80000000
             on this firmware) nor startForegroundService cross-process. Same proven
             bridge the RoadSense/Location sidecars use. Library sounds are streamed
             from the daemon's authenticated /api/audio/library/raw (the app UID can't
             read /data/local/tmp), so exporting carries no file-access surface. -->
        <service
            android:name="com.overdrive.app.services.MediaPlaybackService"
            android:foregroundServiceType="mediaPlayback"
            android:exported="true" />

        <!-- Authenticated Remote Overdrive Dev View bridge. The CameraDaemon
             runs as shell and is the only external caller. android.permission.DUMP
             is signature-level and held by shell/system, preventing ordinary apps
             from starting this exported component. The service then requires a
             fresh in-memory secret and binds its data socket to 127.0.0.1 only. -->
        <service
            android:name="com.overdrive.app.remote.RemoteDevViewBridgeService"
            android:exported="true"
            android:permission="android.permission.DUMP" />

        <!-- Vehicle Actuator Service - runs BYD SDK writes (mirror fold, HUD) in the REAL
             app process (UID 10xxx, real Context), as a SECOND attempt after the daemon's
             own write, in case this HAL only honours the call from a normal app process.
             NOTE: this is a hypothesis, not a proven mechanism — the OEM vehicle-control app
             app never actually calls its own mirror-fold code (no callers anywhere; the
             DiLink-5 controller hard-returns false), so "it works there" is unsupported.
             Treat this service as a belt-and-braces path, not the fix. exported=true is REQUIRED: the
             CameraDaemon (shell uid 2000) reaches it via
             `am start-foreground-service -n com.overdrive.app/.services.VehicleActuatorService`
             — the same proven bridge as MediaPlaybackService. Inputs are Intent extras
             (fold / level), so exporting carries no file/data surface. -->
        <service
            android:name="com.overdrive.app.services.VehicleActuatorService"
            android:foregroundServiceType="specialUse|dataSync"
            android:exported="true">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Owner-initiated BYD vehicle control (mirror fold, HUD) from the app process" />
        </service>

        <!-- Message Overlay Service - draws the "Show Toast" / "Show Dialog"
             automation/keymap message as a TYPE_APPLICATION_OVERLAY in the REAL app
             process. exported=true is REQUIRED: the CameraDaemon (shell uid 2000)
             launches it via
             `am start-foreground-service -n com.overdrive.app/.overlay.MessageOverlayService`
             — the daemon has no UI surface. Same proven bridge as MediaPlaybackService /
             the RoadSense overlay. Non-focusable window so it never steals focus from the
             foreground app; all content comes from the launching Intent extras (no file
             or data-access surface), so exporting carries no additional risk. -->
        <service
            android:name="com.overdrive.app.overlay.MessageOverlayService"
            android:foregroundServiceType="specialUse|dataSync"
            android:exported="true" />


        <!-- AccessibilityService Keep-Alive - Highest process priority protection.
             Prevents BYD firmware from killing the app after 24 hours.
             Enable via: settings put secure enabled_accessibility_services com.overdrive.app/com.overdrive.app.services.KeepAliveAccessibilityService
                         settings put secure accessibility_enabled 1 -->
        <service
            android:name="com.overdrive.app.services.KeepAliveAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="false">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- FileProvider for sharing video files -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

    </application>
</manifest>
